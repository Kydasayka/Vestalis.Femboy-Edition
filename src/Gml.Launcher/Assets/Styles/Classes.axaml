<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Gml.Launcher.Views.Components">

    <Design.PreviewWith>
        <components:StackFrameBorder Padding="20">
            <TextBox Text="Поле для ввода" />
            <TextBox Text="For" Classes="FormBox" />
        </components:StackFrameBorder>
    </Design.PreviewWith>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Manrope" />
    </Style>

    <Style Selector="TextBlock.FormText">
        <Setter Property="Foreground" Value="{DynamicResource ContentColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0, 0, 0, 8" />
    </Style>

    <Style Selector="CheckBox.FormCheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ContentColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Slider.FormSlider /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="Slider.FormSlider /template/ Thumb#thumb /template/ Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="CheckBox.FormCheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="TextBlock.HeadlineText">
        <Setter Property="Margin" Value="0, 0, 0, 8" />
        <Setter Property="Foreground" Value="{DynamicResource HeadlineColor}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style Selector="TextBox.FormBox">
        <Setter Property="Foreground" Value="{DynamicResource ContentColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource FormBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FormBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="TextBox.FormBox:pointerover /template/  Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FormBorderHoverColor}" />
    </Style>
    <Style Selector="TextBox.FormBox:focus /template/  Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#FF1B0E1B" />
        <Setter Property="BoxShadow" Value="0 0 12 0 #4400FFFF" />
    </Style>

    <Style Selector="StackPanel.MarginBottom">
        <Setter Property="Margin" Value="0, 0, 0, 15" />
    </Style>

    <Style Selector="Border.Separator">
        <Setter Property="Margin" Value="0, 20" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource FormBorderColor}" />
    </Style>

    <Style Selector="ProgressBar.ProgressBar">
        <Setter Property="Background" Value="{DynamicResource FormBorderColor}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="ComboBox.ComboBoxStyle">
        <Setter Property="Background" Value="{DynamicResource FrameBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBackgroundBorderColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20, 15, 5, 15" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="ComboBox.ComboBoxStyle:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBackgroundBorderColor}" />
    </Style>

    <Style Selector="components|ServerInfo.Animated">
        <Style.Animations>
            <Animation Duration="0:0:0.5" IterationCount="1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--
        Sci-fi page entrance. Pages are recreated by the view locator on every navigation, so the
        animation runs each time the user switches between screens.
    -->
    <Style Selector="UserControl.Page">
        <Style.Animations>
            <Animation Duration="0:0:0.42" IterationCount="1" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Margin" Value="0,16,0,0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Margin" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Card with a soft neon glow that follows the pointer. -->
    <Style Selector="Border.SciFiCard">
        <Setter Property="Background" Value="#B010141A" />
        <Setter Property="BorderBrush" Value="#FF262B33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.35" IterationCount="1" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.SciFiCard:pointerover">
        <Setter Property="Background" Value="#E0151B23" />
        <Setter Property="BorderBrush" Value="#9916F0FF" />
        <Setter Property="BoxShadow" Value="0 0 18 0 #3316F0FF" />
    </Style>

    <!-- Compact counter tile used on the mods page. -->
    <Style Selector="Border.SciFiStat">
        <Setter Property="Background" Value="#66141820" />
        <Setter Property="BorderBrush" Value="#332E333C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Icon tile that sits on the left side of a mod card. -->
    <Style Selector="Border.SciFiIcon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#3316F0FF" />
        <Setter Property="BorderBrush" Value="#5516F0FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Smooth colour fades for every button, including the ones nested in custom templates. -->
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox.FormBox /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

</Styles>
