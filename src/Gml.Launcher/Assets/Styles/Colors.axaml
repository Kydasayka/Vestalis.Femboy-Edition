<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryColor">#FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryColorHover">#FF55FF</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryTransparentColor">#DD00DD</SolidColorBrush>

    <SolidColorBrush x:Key="HeadlineColor">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ContentColor">#969696</SolidColorBrush>

    <SolidColorBrush x:Key="BackgroundColor">#0E0E0E</SolidColorBrush>

    <SolidColorBrush x:Key="FrameBackgroundColor">#111111</SolidColorBrush>
    <SolidColorBrush x:Key="FrameBackgroundBorderColor">#2E2E2E</SolidColorBrush>

    <SolidColorBrush x:Key="SecondaryColor">#060B0D</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryColorHover">#131719</SolidColorBrush>

    <SolidColorBrush x:Key="FormBackgroundColor">#151515</SolidColorBrush>
    <SolidColorBrush x:Key="FormBackgroundHoverColor">#1C1C1C</SolidColorBrush>
    <SolidColorBrush x:Key="FormBorderColor">#212121</SolidColorBrush>
    <SolidColorBrush x:Key="FormBorderHoverColor">#2C2C2C</SolidColorBrush>


    <SolidColorBrush x:Key="BadgeBorder">#20FFFFFF</SolidColorBrush>

    <!--
        Surfaces and accents shared by the sci-fi cards, toggles and list rows. They are derived
        from the palette above (frame background, form border, primary accent) so every page looks
        like one product instead of having its own colour scheme.
    -->
    <SolidColorBrush x:Key="CardBackgroundColor">#CC111111</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundHoverColor">#F21A1A1A</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderColor">#FF2E2E2E</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderHoverColor">#99FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="CardGlowColor">#33FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftColor">#33FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBorderColor">#55FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="MutedSurfaceColor">#66141414</SolidColorBrush>

    <SolidColorBrush x:Key="ToggleTrackColor">#FF141414</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleTrackCheckedColor">#33FF00FF</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleThumbColor">#FF5A5A5A</SolidColorBrush>

    <LinearGradientBrush x:Key="ProfileLinearGradient" StartPoint="0%, 0%" EndPoint="0%, 100%" Opacity=".3">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.2" Color="#10018A44" />
            <GradientStop Offset="1" Color="#018A44" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProfileImageLinearGradient" StartPoint="50%, -80%" EndPoint="50%, 100%" Opacity=".2">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#111111" />
            <GradientStop Offset="1" Color="#111111" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundOverlay" StartPoint="50%, -80%" EndPoint="50%, 100%" Opacity=".9">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.3" Color="#0E0E0E" />
            <GradientStop Offset="1" Color="#0E0E0E" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

</ResourceDictionary>
