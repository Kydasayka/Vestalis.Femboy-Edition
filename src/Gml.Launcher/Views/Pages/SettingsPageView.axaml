<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
             xmlns:models="clr-namespace:Gml.Launcher.Models"
             xmlns:lang="clr-namespace:Gml.Launcher.Assets.Resources"
             xmlns:vm="clr-namespace:Gml.Launcher.ViewModels.Pages"
             xmlns:converters="clr-namespace:Gml.Launcher.Core.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             x:DataType="vm:SettingsPageViewModel"
             x:Class="Gml.Launcher.Views.Pages.SettingsPageView"
             Classes="Page">
    <Grid>
        <!-- Background -->
        <components:BackgroundComponent Grid.Column="0" />
        <Border Padding="20">
            <Grid ColumnDefinitions="350, 30, .6*, 30 0.2*" RowDefinitions="Auto, 30, *">

                <!-- Navigation -->
                <Grid Grid.ColumnSpan="3" Grid.Row="0">
                    <components:GmlButton Classes="TextIcon Additional"
                                          Padding="15, 0, 20 ,0"
                                          IconPath="/Assets/Images/back.svg"
                                          IconSize="22"
                                          Text="{x:Static lang:Resources.Back}"
                                          Command="{Binding GoBackCommand}" />
                </Grid>

                <!-- RAM and JVM arguments -->
                <ScrollViewer components:SmoothScroll.IsEnabled="True" Grid.Row="2"
                                               Grid.Column="0"
                                               Padding="0,0,6,0"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <components:StackFrameBorder Spacing="10"
                                                      VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0, 0, 0, 10"
                                        Spacing="10">
                                <Svg Path="/Assets/Images/ram.svg"
                                     Width="28"
                                     Height="28" />
                                <TextBlock Text="{x:Static lang:Resources.SettingsRamTitle}"
                                           Classes="HeadlineText"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Static lang:Resources.SettingsRamDescription}"
                                       TextWrapping="Wrap"
                                       Margin="38, 0, 0, 0"
                                       LineHeight="25"
                                       Classes="FormText" />

                            <Border Classes="Separator" Margin="0, 10" />

                            <TextBlock Text="{x:Static lang:Resources.JvmXmsTitle}"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="{x:Static lang:Resources.JvmXmsDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <Slider Minimum="{Binding MinJvmRamValue}"
                                    Maximum="{Binding XmxRamValue}"
                                    Value="{Binding XmsRamValue, Mode=TwoWay}"
                                    TickFrequency="{Binding RamTickValue}"
                                    IsSnapToTickEnabled="True"
                                    Classes="FormSlider" />
                            <TextBlock Text="{Binding XmsRamValueView}"
                                       Classes="FormText"
                                       FontSize="16"
                                       Foreground="{DynamicResource HeadlineColor}"
                                       HorizontalAlignment="Right" />

                            <Border Classes="Separator" Margin="0, 5" />

                            <TextBlock Text="{x:Static lang:Resources.JvmXmxTitle}"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="{x:Static lang:Resources.JvmXmxDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <Slider Minimum="{Binding MinXmxRamValue}"
                                    Maximum="{Binding MaxJvmRamValue}"
                                    Value="{Binding XmxRamValue, Mode=TwoWay}"
                                    TickFrequency="{Binding RamTickValue}"
                                    IsSnapToTickEnabled="True"
                                    Classes="FormSlider" />
                            <TextBlock Text="{Binding XmxRamValueView}"
                                       Classes="FormText"
                                       FontSize="16"
                                       Foreground="{DynamicResource HeadlineColor}"
                                       HorizontalAlignment="Right" />
                        </components:StackFrameBorder>

                        <!-- Additional JVM arguments -->
                        <components:StackFrameBorder Spacing="10" VerticalAlignment="Top">
                            <TextBlock Text="{x:Static lang:Resources.JvmArgsTitle}"
                                       Classes="HeadlineText"
                                       TextWrapping="Wrap" />
                            <Border Classes="Separator" Margin="0, 5" />
                            <TextBlock Text="{x:Static lang:Resources.JvmArgsDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <TextBox Classes="FormBox"
                                     Text="{Binding CustomJvmArguments, Mode=TwoWay}"
                                     Watermark="{x:Static lang:Resources.JvmArgsPlaceholder}" />
                        </components:StackFrameBorder>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer components:SmoothScroll.IsEnabled="True" Grid.Row="2"
                                               Grid.Column="2"
                                               Padding="0,0,6,0"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">

                    <!-- Game Window Size -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/window.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.WindowSize}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <CheckBox Content="{x:Static lang:Resources.FullScreen}"
                                  Classes="SciFiToggle"
                                  IsChecked="{Binding FullScreen}" />

                        <Border Classes="Separator" Margin="0, 10"
                                IsVisible="{Binding FullScreen, Converter={converters:BoolReverseConverter}}" />

                        <Grid ColumnDefinitions="*, 10, Auto, 10, *"
                              Margin="0, 10, 0, 0"
                              IsVisible="{Binding FullScreen, Converter={converters:BoolReverseConverter}}">
                            <TextBox Grid.Column="0"
                                     Classes="FormBox"
                                     Text="{Binding WindowWidth}"
                                     TextChanged="OnTextInput" />
                            <TextBlock Text="x"
                                       Classes="FormText"
                                       VerticalAlignment="Center"
                                       Grid.Column="2" />
                            <TextBox Grid.Column="4"
                                     TextChanged="OnTextInput"
                                     Text="{Binding WindowHeight}"
                                     Classes="FormBox" />
                        </Grid>


                    </components:StackFrameBorder>

                    <!-- Installation directory -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/folder.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.InstallationDirectory}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <Grid Margin="0, 10, 0, 0"
                              ColumnDefinitions="*, 15, Auto">
                            <TextBox Grid.Column="0"
                                     Classes="FormBox"
                                     Text="{Binding InstallationFolder}" />

                            <StackPanel Grid.Column="2" Spacing="10" Orientation="Horizontal">
                                <components:GmlButton Classes="Icon Additional"
                                                      IconPath="/Assets/Images/folder.svg"
                                                      IconSize="22"
                                                      HorizontalAlignment="Right"
                                                      CornerRadius="10"
                                                      Click="OpenLocation"
                                                      Text="{x:Static lang:Resources.Edit}" />
                                <components:GmlButton Classes="Icon Additional"
                                                      IconPath="/Assets/Images/edit.svg"
                                                      IconSize="22"
                                                      HorizontalAlignment="Right"
                                                      CornerRadius="10"
                                                      Click="OpenFileDialog"
                                                      Text="{x:Static lang:Resources.Edit}" />
                            </StackPanel>

                        </Grid>

                    </components:StackFrameBorder>

                    <!-- Interface sounds -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/settings.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.InterfaceSounds}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <Grid ColumnDefinitions="*, 15, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lang:Resources.InterfaceSoundsDescription}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Classes="FormText"
                                       Margin="0" />
                            <CheckBox Grid.Column="2"
                                      Classes="SciFiToggle"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding InterfaceSounds, Mode=TwoWay}" />
                        </Grid>

                    </components:StackFrameBorder>

                    <!-- Device identifier (HWID) -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/server.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.HwidTitle}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <TextBlock Text="{x:Static lang:Resources.HwidDescription}"
                                   TextWrapping="Wrap"
                                   Classes="FormText"
                                   Margin="0" />

                        <Grid ColumnDefinitions="*, 15, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lang:Resources.HwidSend}"
                                       VerticalAlignment="Center"
                                       Classes="FormText"
                                       Margin="0" />
                            <CheckBox Grid.Column="2"
                                      Classes="SciFiToggle"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SendHwid, Mode=TwoWay}" />
                        </Grid>

                    </components:StackFrameBorder>

                    <!-- Optional service access: switch the mirror backend mode -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/password.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="Сервисный доступ"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <TextBlock Text="Ключ хранится только на этом компьютере. С верным ключом можно переключать режим бэкенда между локальным зеркалом и прокси на основной сервер."
                                   TextWrapping="Wrap"
                                   Classes="FormText"
                                   Margin="0" />

                        <Grid ColumnDefinitions="*, 10, Auto"
                              Margin="0, 10, 0, 0">
                            <TextBox Grid.Column="0"
                                     Classes="FormBox"
                                     PasswordChar="●"
                                     Text="{Binding ServiceKey, Mode=TwoWay}"
                                     Watermark="Сервисный ключ" />
                            <components:GmlButton Grid.Column="2"
                                                  Classes="Text Additional"
                                                  Height="42"
                                                  Text="Проверить"
                                                  IsEnabled="{Binding !IsServiceKeyBusy}"
                                                  Command="{Binding VerifyServiceKeyCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding BackendControlStatus}"
                                   TextWrapping="Wrap"
                                   Classes="FormText"
                                   Margin="0" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    IsVisible="{Binding IsServiceKeySaved}">
                            <components:GmlButton Classes="Text Additional"
                                                  Height="42"
                                                  Text="Удалить ключ"
                                                  IsEnabled="{Binding !IsServiceKeyBusy}"
                                                  Command="{Binding ClearServiceKeyCommand}" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 5"
                                IsVisible="{Binding IsBackendControlAvailable}" />

                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsBackendControlAvailable}">
                            <TextBlock Text="Режим бэкенда"
                                       Classes="FormText"
                                       FontSize="15" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <components:GmlButton Classes="Text Additional"
                                                      Height="42"
                                                      Text="Зеркало (кэш)"
                                                      IsEnabled="{Binding !IsServiceKeyBusy}"
                                                      Command="{Binding SetBackendModeCommand}"
                                                      CommandParameter="local" />
                                <components:GmlButton Classes="Text Additional"
                                                      Height="42"
                                                      Text="Прокси (основной)"
                                                      IsEnabled="{Binding !IsServiceKeyBusy}"
                                                      Command="{Binding SetBackendModeCommand}"
                                                      CommandParameter="proxy" />
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 5"
                                IsVisible="{Binding IsBackendTorAvailable}" />

                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsBackendTorAvailable}">
                            <TextBlock Text="Маршрутизация через Tor"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="Через Tor идут только запросы этого бэкенда к основному серверу (gmlfr.vestalis.xyz). Остальной трафик остаётся напрямую."
                                       TextWrapping="Wrap"
                                       Classes="FormText"
                                       Margin="0" />
                            <Grid ColumnDefinitions="*, 12, Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Отправлять запросы к основному бэкенду через Tor"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Classes="FormText"
                                           Margin="0, 0, 8, 0" />
                                <CheckBox Grid.Column="2"
                                          Classes="SciFiToggle"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding !IsServiceKeyBusy}"
                                          IsChecked="{Binding IsBackendTorEnabled, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 5"
                                IsVisible="{Binding IsBackendControlAvailable}" />

                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsBackendControlAvailable}">
                            <TextBlock Text="Самодиагностика"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="Проверяет конфигурацию, режим, кэш, данные зеркала, файлы и доступность прокси-сервера. Занимает до 15 секунд."
                                       TextWrapping="Wrap"
                                       Classes="FormText"
                                       Margin="0" />
                            <components:GmlButton Classes="Text Additional"
                                                  Height="42"
                                                  HorizontalAlignment="Left"
                                                  Text="Проверить бэкенд"
                                                  IsEnabled="{Binding !IsSelfTestRunning}"
                                                  Command="{Binding RunSelfTestCommand}" />

                            <TextBlock Text="{Binding SelfTestSummary}"
                                       TextWrapping="Wrap"
                                       Classes="FormText"
                                       Margin="0"
                                       IsVisible="{Binding HasSelfTestResults}" />

                            <ItemsControl ItemsSource="{Binding SelfTestChecks}"
                                          IsVisible="{Binding HasSelfTestResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SelfTestRow">
                                        <Border Background="{DynamicResource FormBackgroundColor}"
                                                BorderBrush="{DynamicResource FormBorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                Margin="0, 0, 0, 8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto, 10, *, Auto, 8, Auto">
                                                    <Border Grid.Column="0"
                                                            Width="8"
                                                            Height="8"
                                                            CornerRadius="4"
                                                            Background="{Binding Brush}"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ContentColor}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding StatusText}"
                                                               Foreground="{Binding Brush}"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Duration}"
                                                               Foreground="{DynamicResource ContentColor}"
                                                               Opacity="0.6"
                                                               FontSize="12" />
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource ContentColor}"
                                                           Opacity="0.85"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </components:StackFrameBorder>

                    </StackPanel>
                </ScrollViewer>

                <!-- Language -->
                <ComboBox Grid.Column="4"
                          Grid.Row="2"
                          Classes="ComboBoxStyle"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Svg Path="{Binding IconPath}"
                                     Width="18"/>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


            </Grid>
        </Border>
    </Grid>
</UserControl>
