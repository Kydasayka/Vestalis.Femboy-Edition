<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
             xmlns:vm="clr-namespace:Gml.Launcher.ViewModels.Pages"
             xmlns:lang="clr-namespace:Gml.Launcher.Assets.Resources"
             xmlns:converters="clr-namespace:Gml.Launcher.Core.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Gml.Launcher.Views.Pages.ModsPageView"
             x:DataType="vm:ModsPageViewModel"
             Classes="Page">
    <Grid>
        <!-- Background -->
        <components:BackgroundComponent Classes="Image" Source="/Assets/Images/background.jpg" />
        <Rectangle Fill="{DynamicResource BackgroundOverlay}" />

        <Border Padding="20">
            <Grid RowDefinitions="Auto, 24, *">

                <!-- Navigation -->
                <Grid Grid.Row="0">
                    <components:GmlButton Classes="TextIcon Additional"
                                          Padding="15, 0, 20 ,0"
                                          IconPath="/Assets/Images/back.svg"
                                          IconSize="22"
                                          Text="{x:Static lang:Resources.Back}"
                                          Command="{Binding GoBackCommand}" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="320, 20, *">

                    <!-- Profile card: description and live counters -->
                    <StackPanel Grid.Column="0"
                                Spacing="16"
                                VerticalAlignment="Top">
                        <components:StackFrameBorder Spacing="10"
                                                     VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0, 0, 0, 10"
                                        Spacing="10">
                                <Svg Path="/Assets/Images/folder.svg"
                                     Width="28"
                                     Height="28" />
                                <TextBlock Text="{x:Static lang:Resources.ModsList}"
                                           Classes="HeadlineText"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Static lang:Resources.ModsListDescription}"
                                       TextWrapping="Wrap"
                                       Margin="38, 0, 0, 0"
                                       LineHeight="25"
                                       Classes="FormText" />

                            <Border Classes="Separator" Margin="0, 5" />

                            <Grid ColumnDefinitions="*, 10, *">
                                <Border Classes="SciFiStat">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding EnabledMods}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                                        <TextBlock Text="{x:Static lang:Resources.ModsEnabled}"
                                                   Classes="FormText"
                                                   Margin="0"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Classes="SciFiStat">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TotalMods}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource HeadlineColor}" />
                                        <TextBlock Text="{x:Static lang:Resources.ModsTotal}"
                                                   Classes="FormText"
                                                   Margin="0"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </components:StackFrameBorder>

                        <!-- Search -->
                        <components:StackFrameBorder Spacing="10"
                                                     VerticalAlignment="Top">
                            <TextBlock Text="{x:Static lang:Resources.ModsSearchTitle}"
                                       Classes="FormText"
                                       Margin="0"
                                       FontSize="13" />
                            <TextBox Classes="FormBox"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     Watermark="{x:Static lang:Resources.ModsSearchPlaceholder}" />
                        </components:StackFrameBorder>
                    </StackPanel>

                    <!-- Mods -->
                    <Grid Grid.Column="2">

                        <!-- No optional mods at all -->
                        <components:StackFrameBorder VerticalAlignment="Top"
                                                     Spacing="10"
                                                     IsVisible="{Binding ModsListIsEmpty}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="10">
                                    <Svg Path="/Assets/Images/folder.svg" Width="48" />
                                    <TextBlock Classes="HeadlineText"
                                               Margin="0, 5, 0, 0"
                                               VerticalAlignment="Center"
                                               Text="{x:Static lang:Resources.Empty}" />
                                </StackPanel>

                                <TextBlock Classes="FormText"
                                           TextWrapping="Wrap"
                                           Text="{x:Static lang:Resources.ModsEmpty}" />
                            </StackPanel>
                        </components:StackFrameBorder>

                        <!-- Nothing matches the search query -->
                        <components:StackFrameBorder VerticalAlignment="Top"
                                                     Spacing="10"
                                                     IsVisible="{Binding IsSearchEmpty}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="10">
                                    <Svg Path="/Assets/Images/document.svg" Width="42" />
                                    <TextBlock Classes="HeadlineText"
                                               Margin="0, 5, 0, 0"
                                               VerticalAlignment="Center"
                                               Text="{x:Static lang:Resources.Empty}" />
                                </StackPanel>

                                <TextBlock Classes="FormText"
                                           TextWrapping="Wrap"
                                           Text="{x:Static lang:Resources.ModsNoSearchResults}" />
                            </StackPanel>
                        </components:StackFrameBorder>

                        <ScrollViewer IsVisible="{Binding !ModsListIsEmpty}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ModsListControl"
                                          ItemsSource="{Binding ProfileOptionalMods}">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate x:DataType="vm:ExternalModReadDto">
                                        <Border Classes="SciFiCard"
                                                Margin="0, 0, 0, 12">
                                            <Grid ColumnDefinitions="Auto, 14, *, 14, Auto"
                                                  VerticalAlignment="Center">
                                                <Border Classes="SciFiIcon">
                                                    <Svg Path="/Assets/Images/document.svg"
                                                         Width="20"
                                                         Height="20" />
                                                </Border>

                                                <StackPanel Grid.Column="2"
                                                            Spacing="3"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource HeadlineColor}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{converters:ModsNameConverter}">
                                                                <Binding Path="." />
                                                                <Binding Path="DataContext"
                                                                         ElementName="ModsListControl" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource ContentColor}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="20"
                                                               FontSize="12">
                                                        <TextBlock.Text>
                                                            <MultiBinding
                                                                Converter="{converters:ModsDescriptionConverter}">
                                                                <Binding Path="." />
                                                                <Binding Path="DataContext"
                                                                         ElementName="ModsListControl" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>

                                                <CheckBox Grid.Column="4"
                                                          Classes="SciFiToggle"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          CommandParameter="{Binding .}"
                                                          Command="{Binding ((vm:ModsPageViewModel)DataContext).ChangeOptionalModState, ElementName=ModsListControl}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
