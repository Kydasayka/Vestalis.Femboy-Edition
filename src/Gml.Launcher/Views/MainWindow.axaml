<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gml.Launcher.ViewModels"
        xmlns:rxui="clr-namespace:Avalonia.ReactiveUI;assembly=Avalonia.ReactiveUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Gml.Launcher.Core.Helpers"
        xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
        xmlns:controls="clr-namespace:GamerVII.Notification.Avalonia.Controls;assembly=GamerVII.Notification.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        MinWidth="1000"
        Width="1000"
        Height="600"
        MinHeight="600"
        CanResize="True"
        SystemDecorations="None"
        ShowInTaskbar="True"
        Closed="WindowClosed"
        x:Class="Gml.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        Icon="/Assets/Images/logo.ico"
        Title="Gml.Launcher">

    <Window.Styles>
        <!--
            The window is borderless (no system decorations) so Windows does not paint its drop
            shadow around the launcher. Caption buttons are drawn here, and the window edges are
            resized manually in MainWindow.axaml.cs.
        -->
        <Style Selector="Button.CaptionButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.CaptionButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.CaptionButton.Close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border Margin="-5" CornerRadius="5" ClipToBounds="True">
            <Panel>
                <ExperimentalAcrylicBorder IsHitTestVisible="False">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial
                            BackgroundSource="Digger"
                            MaterialOpacity="0.85"
                            TintColor="Black"
                            TintOpacity=".9" />
                    </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>

                <Grid>
                    <!-- Background -->
                    <components:BackgroundComponent Classes="Image" Source="/Assets/Images/background.jpg" />

                    <Rectangle Fill="{DynamicResource BackgroundOverlay}" />


                    <!-- Content -->
                    <rxui:RoutedViewHost Router="{Binding Router}">

                        <!--
                            Pages slide in horizontally while the previous one fades out, so
                            switching screens reads as paging instead of an instant swap.
                        -->
                        <rxui:RoutedViewHost.PageTransition>
                            <CompositePageTransition>
                                <CrossFade Duration="0:0:0.2" />
                                <PageSlide Duration="0:0:0.34" Orientation="Horizontal" />
                            </CompositePageTransition>
                        </rxui:RoutedViewHost.PageTransition>

                        <rxui:RoutedViewHost.DefaultContent>
                            <TextBlock Text="Route not found"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </rxui:RoutedViewHost.DefaultContent>
                        <rxui:RoutedViewHost.ViewLocator>
                            <helpers:AppViewLocator />
                        </rxui:RoutedViewHost.ViewLocator>
                    </rxui:RoutedViewHost>

                    <!-- Server selector -->
                    <components:ServerSelectorComponent
                        ZIndex="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,48,20,0" />

                    <!-- Custom caption buttons (the window has no system decorations). -->
                    <StackPanel ZIndex="30"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,10,0">
                        <Button Classes="CaptionButton"
                                Content="&#xE921;"
                                Click="MinimizeClick"
                                ToolTip.Tip="Свернуть" />
                        <Button Classes="CaptionButton"
                                Content="&#xE922;"
                                Click="MaximizeClick"
                                ToolTip.Tip="Развернуть" />
                        <Button Classes="CaptionButton"
                                Classes.Close="True"
                                Content="&#xE8BB;"
                                Click="CloseClick"
                                ToolTip.Tip="Закрыть" />
                    </StackPanel>

                    <!-- Backend mode badge: local mirror vs transparent proxy -->
                    <Border ZIndex="11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,98,20,0"
                            Padding="10,4"
                            CornerRadius="10"
                            IsVisible="{Binding IsBackendModeVisible}"
                            Background="{Binding BackendModeBrush}"
                            ToolTip.Tip="{Binding BackendModeHint}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="White"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BackendModeLabel}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Panel>
        </Border>

        <!-- MessageBar -->
        <controls:NotificationMessageContainer Manager="{Binding Manager}" />

    </Grid>

</Window>
