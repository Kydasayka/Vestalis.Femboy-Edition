<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
        xmlns:viewModels="clr-namespace:Gml.Launcher.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="380"
        d:DesignHeight="210"
        Width="380"
        Height="210"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ShowActivated="False"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        x:Class="Gml.Launcher.Views.SplashScreen.SplashScreen"
        x:DataType="viewModels:SplashScreenViewModel"
        Title="Gml.Launcher">

    <Window.Resources>
        <!-- Soft, heavy rounded wordmark font (Fredoka One, OFL). -->
        <FontFamily x:Key="BrandFont">avares://Gml.Launcher/Assets/Fonts#Fredoka One</FontFamily>

        <!--
            Pastel launcher palette in a cyclic gradient. The code-behind slides it across the
            "Femboy Edition" label; the repeat spread makes the loop seamless. The stops are
            deliberately close in brightness: the sweep should read as a soft glow, not a flare.
        -->
        <LinearGradientBrush x:Key="EditionShimmerBrush"
                             StartPoint="0%, 50%"
                             EndPoint="100%, 50%"
                             SpreadMethod="Repeat">
            <GradientStop Offset="0" Color="#D97BD2" />
            <GradientStop Offset="0.25" Color="#E795DE" />
            <GradientStop Offset="0.5" Color="#F0B6EA" />
            <GradientStop Offset="0.75" Color="#C9A0EA" />
            <GradientStop Offset="1" Color="#D97BD2" />
        </LinearGradientBrush>
    </Window.Resources>

    <!-- No border: the card is just the rounded window surface, no matte outline. -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource FrameBackgroundColor}"
            ClipToBounds="True"
            CornerRadius="15">

        <Grid>
            <StackPanel x:Name="CardContent" VerticalAlignment="Center">
                <!-- Icon + wordmark lockup; the icon spans the wordmark line, the pair stays
                     narrower than the progress bar below. -->
                <Grid ColumnDefinitions="Auto,*" Margin="22,0">
                    <Svg Path="/Assets/Images/logo.svg"
                         Width="56"
                         Height="56"
                         Margin="0,8,10,0"
                         VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Vestalis"
                                   FontFamily="{StaticResource BrandFont}"
                                   FontSize="58"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   LineHeight="62"
                                   Foreground="{StaticResource HeadlineColor}" />

                        <!-- About half the width of the wordmark, tucked under its right edge. -->
                        <TextBlock Text="Femboy Edition"
                                   FontFamily="{StaticResource BrandFont}"
                                   FontSize="15"
                                   HorizontalAlignment="Right"
                                   Margin="0,-2,1,0"
                                   LineHeight="19"
                                   Foreground="{StaticResource EditionShimmerBrush}" />
                    </StackPanel>
                </Grid>

                <ProgressBar IsIndeterminate="{Binding InfinityLoading}"
                             Value="{Binding Progress}"
                             Maximum="100"
                             Classes="ProgressBar"
                             Background="#1C1C1C"
                             Margin="20, 16, 20, 10"
                             Height="1"
                             VerticalAlignment="Bottom" />

                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Opacity="0.85"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ContentColor}" />
            </StackPanel>
        </Grid>

    </Border>

</Window>
