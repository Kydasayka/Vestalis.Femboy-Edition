// Visibility helpers for the layout editor. Hidden flags are plain properties
// so they can be read from pure bindings; Rust keeps the authoritative list in
// state.json.
export global LayoutState {
    in-out property <bool> hidden-user: false;
    in-out property <bool> hidden-profiles: false;
    in-out property <bool> hidden-countdown: false;
    in-out property <bool> hidden-sidebar-actions: false;
    in-out property <bool> hidden-news: false;
    in-out property <bool> hidden-main-actions: false;
    in-out property <bool> hidden-server: false;

    // Per-block heights. The same values are shown by the Layout editor and
    // used by every zone, so hiding and showing a block preserves its size.
    in-out property <int> height-user: 64;
    in-out property <int> height-profiles: 200;
    in-out property <int> height-countdown: 124;
    in-out property <int> height-sidebar-actions: 44;
    in-out property <int> height-news: 220;
    in-out property <int> height-main-actions: 52;

    public pure function block-height(item: string) -> int {
        if item == "user" { return height-user; }
        if item == "profiles" { return height-profiles; }
        if item == "countdown" { return height-countdown; }
        if item == "sidebar-actions" { return height-sidebar-actions; }
        if item == "news" { return height-news; }
        if item == "main-actions" { return height-main-actions; }
        return 0;
    }

    callback resize-block(string, int);

    public pure function is-hidden(item: string) -> bool {
        if item == "user" { return hidden-user; }
        if item == "profiles" { return hidden-profiles; }
        if item == "countdown" { return hidden-countdown; }
        if item == "sidebar-actions" { return hidden-sidebar-actions; }
        if item == "news" { return hidden-news; }
        if item == "main-actions" { return hidden-main-actions; }
        if item == "server" { return hidden-server; }
        return false;
    }

    callback toggle-hidden(string, bool);
}

