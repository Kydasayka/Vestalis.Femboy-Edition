import { ScrollView } from "std-widgets.slint";

// Rounded UI font with Cyrillic coverage (Nunito, OFL).
import "../assets/fonts/Nunito-Regular.ttf";
import "../assets/fonts/Nunito-SemiBold.ttf";
import "../assets/fonts/Nunito-Bold.ttf";

// Active visual theme. Rust overwrites these tokens at startup and whenever a
// theme is selected; the literals here are only the dark defaults.
export global Theme {
    in-out property <string> mode: "base";
    in-out property <color> background: #0d0d10;
    in-out property <color> background-alt: #09090c;
    in-out property <color> surface: #16161c;
    in-out property <color> surface-hover: #202028;
    in-out property <color> border: #2a2a33;
    in-out property <color> text: #f2f2f7;
    in-out property <color> text-muted: #b9b9c4;
    in-out property <color> accent: #a21caf;
    in-out property <color> accent-hover: #d946ef;
    in-out property <color> accent-text: #ffffff;
    in-out property <color> success: #4ade80;
    in-out property <color> warning: #fbbf24;
    in-out property <color> danger: #f87171;
    in-out property <color> gradient-start: #a21caf;
    in-out property <color> gradient-end: #6d28d9;
    in-out property <color> shadow: #00000080;
    in-out property <color> scrim: #00000000;

    in-out property <color> primary-container: #4a044e;
    in-out property <color> on-primary-container: #f5d0fe;
    in-out property <color> secondary: #c084fc;
    in-out property <color> on-secondary: #1a0a20;
    in-out property <color> tertiary: #f472b6;
    in-out property <color> on-tertiary: #2a0a18;
    in-out property <color> surface-low: #101015;
    in-out property <color> surface-high: #202029;
    in-out property <color> surface-variant: #26262e;
    in-out property <color> on-surface-variant: #c4c4cf;
    in-out property <color> outline: #4a4a55;
    in-out property <color> error: #f87171;
    in-out property <color> on-error: #2a0a0a;

    in-out property <color> glass-tint: #ffffff14;
    in-out property <color> glass-border: #ffffff2e;
    in-out property <color> glass-highlight: #ffffff1f;

    in-out property <length> radius-xs: 3px;
    in-out property <length> radius-sm: 8px;
    in-out property <length> radius-md: 11px;
    in-out property <length> radius-lg: 14px;
    in-out property <length> radius-pill: 99px;

    in-out property <float> card-opacity: 0.92;
    in-out property <string> font-family: "Nunito";
    in-out property <int> base-font-weight: 600;
    in-out property <string> background-effect: "none";
}

// User-facing strings a theme may override. Critical errors and window
// controls deliberately stay in the launcher.
export global Texts {
    in-out property <string> app-title: "Vestalis Launcher";
    in-out property <string> app-subtitle: "Femboy";
    in-out property <string> login-title: "Вход в аккаунт";
    in-out property <string> login-subtitle: "Войдите, чтобы играть на серверах Vestalis";
    in-out property <string> login-submit: "Войти";
    in-out property <string> login-offline: "Оффлайн-режим";
    in-out property <string> play: "Играть";
    in-out property <string> settings: "Настройки";
    in-out property <string> logout: "Выйти";
    in-out property <string> refresh: "Обновить";
    in-out property <string> mods: "Моды";
    in-out property <string> profiles: "ПРОФИЛИ";
    in-out property <string> news: "НОВОСТИ";
    in-out property <string> settings-title: "Настройки";
    in-out property <string> back: "← Назад";
}

// Optional theme icons. When a theme does not provide one, the launcher draws
// its built-in vector icon.
export global ThemeIcons {
    in-out property <image> server;
    in-out property <bool> has-server: false;
    in-out property <image> chevron;
    in-out property <bool> has-chevron: false;
    in-out property <image> play;
    in-out property <bool> has-play: false;
    in-out property <image> settings;
    in-out property <bool> has-settings: false;
    in-out property <image> mods;
    in-out property <bool> has-mods: false;
    in-out property <image> refresh;
    in-out property <bool> has-refresh: false;
    in-out property <image> minimize;
    in-out property <bool> has-minimize: false;
    in-out property <image> maximize;
    in-out property <bool> has-maximize: false;
    in-out property <image> restore;
    in-out property <bool> has-restore: false;
    in-out property <image> close;
    in-out property <bool> has-close: false;
    in-out property <image> warning;
    in-out property <bool> has-warning: false;
    in-out property <image> error;
    in-out property <bool> has-error: false;
    in-out property <image> success;
    in-out property <bool> has-success: false;
}


export struct ProfileItem {
    id: int,
    name: string,
    display-name: string,
    initial: string,
    subtitle: string,
    description: string,
    online: int,
    icon: image,
    has-icon: bool,
}

export struct NewsItem {
    title: string,
    body: string,
    date: string,
}

export struct ModItem {
    id: int,
    name: string,
    description: string,
    enabled: bool,
}

export struct SelfTestItem {
    name: string,
    status: string,
    message: string,
    duration: string,
}

export struct ThemeOption {
    name: string,
    builtin: bool,
    accent: color,
    surface: color,
    text: color,
}

// Ambient background effects, driven by Slint's animation clock so they do not
// need a Rust timer. Only the selected variant is instantiated.
component BackgroundEffect inherits Rectangle {
    in property <string> kind: "none";

    if kind == "fireflies": Rectangle {
        for i in 16: Rectangle {
            width: 3px + Math.mod(i, 3) * 1px;
            height: self.width;
            border-radius: Theme.radius-pill;
            background: Theme.warning;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.warning.with-alpha(0.8);
            opacity: 0.2 + 0.75 * abs(sin((animation-tick() / 1s * (18 + Math.mod(i, 6)) + i * 61) * 1deg));
            x: parent.width * (0.04 + Math.mod(i * 37 + 13, 90) / 100.0)
                + 24px * sin((animation-tick() / 1s * (7 + Math.mod(i, 5)) + i * 29) * 1deg);
            y: parent.height * (0.1 + Math.mod(i * 29 + 7, 78) / 100.0)
                + 18px * sin((animation-tick() / 1s * (10 + Math.mod(i, 4)) + i * 47) * 1deg);
        }
    }

    if kind == "leaves": Rectangle {
        for i in 18: Rectangle {
            width: 10px + Math.mod(i, 4) * 3px;
            height: self.width * 0.62;
            border-radius: Theme.radius-pill;
            background: Math.mod(i, 4) == 0 ? Theme.warning
                : Math.mod(i, 4) == 1 ? Theme.warning.darker(0.15)
                : Math.mod(i, 4) == 2 ? Theme.success
                : Theme.warning.darker(0.3);
            opacity: 0.55 + 0.35 * abs(sin((animation-tick() / 1s * (9 + Math.mod(i, 5)) + i * 23) * 1deg));
            transform-rotation: sin((animation-tick() / 1s * (24 + Math.mod(i, 5)) + i * 33) * 1deg) * 40deg + i * 17deg;
            x: parent.width * (0.02 + Math.mod(i * 41 + 7, 94) / 100.0)
                + (34px + Math.mod(i, 4) * 8px)
                    * sin((animation-tick() / 1s * (23 + Math.mod(i, 3) * 14) + i * 37) * 1deg);
            y: -28px + (parent.height + 56px)
                * Math.mod(animation-tick() + i * 1400ms, (9 + Math.mod(i, 7)) * 1s)
                / ((9 + Math.mod(i, 7)) * 1s);
        }
    }

    if kind == "snow": Rectangle {
        for i in 28: Rectangle {
            width: 2px + Math.mod(i, 4) * 1.2px;
            height: self.width;
            border-radius: Theme.radius-pill;
            background: Theme.text;
            opacity: 0.35 + 0.55 * abs(sin((animation-tick() / 1s * (10 + Math.mod(i, 7)) + i * 41) * 1deg));
            x: parent.width * (0.01 + Math.mod(i * 43 + 11, 97) / 100.0)
                + (16px + Math.mod(i, 5) * 7px)
                    * sin((animation-tick() / 1s * (18 + Math.mod(i, 4) * 11) + i * 53) * 1deg);
            y: -12px + (parent.height + 24px)
                * Math.mod(animation-tick() + i * 900ms, (7 + Math.mod(i, 8)) * 1s)
                / ((7 + Math.mod(i, 8)) * 1s);
        }
    }
}

// Soft colour fields behind Liquid Glass panels. Slint cannot blur the actual
// backdrop, so these blurred blobs provide the colour bleed that makes the
// translucent panels read as glass.
component GlassBackdrop inherits Rectangle {
    Rectangle {
        x: parent.width * 0.05;
        y: parent.height * 0.10;
        width: 340px;
        height: 340px;
        border-radius: Theme.radius-pill;
        background: Theme.gradient-start.with-alpha(0.30);
        drop-shadow-blur: 130px;
        drop-shadow-color: Theme.gradient-start.with-alpha(0.55);
    }
    Rectangle {
        x: parent.width * 0.62;
        y: parent.height * 0.42;
        width: 420px;
        height: 420px;
        border-radius: Theme.radius-pill;
        background: Theme.gradient-end.with-alpha(0.28);
        drop-shadow-blur: 150px;
        drop-shadow-color: Theme.gradient-end.with-alpha(0.50);
    }
    Rectangle {
        x: parent.width * 0.35;
        y: parent.height * 0.65;
        width: 280px;
        height: 280px;
        border-radius: Theme.radius-pill;
        background: Theme.tertiary.with-alpha(0.18);
        drop-shadow-blur: 120px;
        drop-shadow-color: Theme.tertiary.with-alpha(0.35);
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    height: 44px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: !available
        ? Theme.border
        : Theme.mode == "liquid-glass"
            ? Theme.glass-border
            : (primary ? Theme.accent-hover : Theme.border);
    background: !available ? Theme.background-alt
        : area.has-hover
            ? (primary ? Theme.accent-hover : (Theme.mode == "liquid-glass" ? Theme.glass-highlight : Theme.surface-hover))
            : (primary
                ? (Theme.mode == "liquid-glass" ? Theme.accent.with-alpha(0.86) : Theme.accent)
                : (Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.surface));
    animate background { duration: 130ms; easing: ease-out; }

    area := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if root.has-icon: Image {
        x: 12px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }

    Text {
        x: root.has-icon ? 34px : 0;
        width: root.has-icon ? parent.width - 40px : parent.width;
        height: parent.height;
        text: root.label;
        color: root.available ? (root.primary ? Theme.accent-text : Theme.text) : Theme.text-muted;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: root.has-icon ? left : center;
        vertical-alignment: center;
    }
}

component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> numeric: false;
    callback accepted();

    height: 46px;
    border-radius: Theme.radius-md;
    background: Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.background-alt;
    border-width: 1px;
    border-color: input.has-focus
        ? Theme.accent
        : (Theme.mode == "liquid-glass" ? Theme.glass-border : Theme.border);

    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : (root.numeric ? InputType.number : InputType.text);
        selection-background-color: Theme.accent;
        accepted => { root.accepted(); }

        // Slint's built-in shortcut lookup can miss Ctrl+V on a non-English
        // layout; accept both the Latin and Cyrillic V keys.
        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М") {
                self.paste();
                return accept;
            }
            return reject;
        }
    }

    if input.text.is-empty && !root.placeholder.is-empty: Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component CaptionButton inherits Rectangle {
    in property <string> kind: "min";
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    width: 38px;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: area.has-hover
        ? (kind == "close" ? Theme.danger : Theme.surface-hover)
        : transparent;
    animate background { duration: 120ms; easing: ease-out; }

    property <color> icon-color: area.has-hover
        ? (kind == "close" ? Theme.accent-text : Theme.text)
        : Theme.text-muted;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if has-icon: Image {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }

    if !has-icon && kind == "min": Rectangle {
        width: 11px;
        height: 1.5px;
        x: (parent.width - 11px) / 2;
        y: (parent.height - 1.5px) / 2;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }

    if !has-icon && kind == "max": Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        border-width: 1.5px;
        border-color: icon-color;
        border-radius: Theme.radius-xs;
        background: transparent;
    }

    if !has-icon && kind == "restore": Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: 9px;
            height: 9px;
            x: (parent.width - 11px) / 2;
            y: (parent.height - 11px) / 2;
            border-width: 1.5px;
            border-color: icon-color;
            border-radius: Theme.radius-xs;
            background: transparent;
        }
        Rectangle {
            width: 9px;
            height: 9px;
            x: (parent.width - 11px) / 2 + 3px;
            y: (parent.height - 11px) / 2 + 3px;
            border-width: 1.5px;
            border-color: icon-color;
            border-radius: Theme.radius-xs;
            background: area.has-hover ? Theme.surface-hover : Theme.background-alt;
        }
    }

    if !has-icon && kind == "close": Rectangle {
        width: 13px;
        height: 1.5px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 1.5px) / 2;
        transform-rotation: 45deg;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }
    if !has-icon && kind == "close": Rectangle {
        width: 13px;
        height: 1.5px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 1.5px) / 2;
        transform-rotation: -45deg;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }
}

component ServerMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: active
        ? Theme.accent.with-alpha(0.18)
        : (area.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: 110ms; easing: ease-out; }

    Rectangle {
        width: 3px;
        height: 18px;
        x: 1px;
        y: (parent.height - 18px) / 2;
        border-radius: Theme.radius-pill;
        background: Theme.accent;
        visible: root.active;
    }

    Text {
        x: 14px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 14px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
    }

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MiniButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 26px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: area.has-hover ? Theme.surface-hover : transparent;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LayoutRow inherits Rectangle {
    in property <string> item;
    in property <bool> pinned: false;
    callback move(string, string);

    height: 34px;

    Text {
        x: 8px;
        width: parent.width - 130px;
        height: parent.height;
        text: item == "server" ? "Выбор сервера"
            : item == "user" ? "Карточка пользователя"
            : item == "profiles" ? "Список профилей"
            : item == "countdown" ? "Отсчёт «Недрочабрь»"
            : item == "sidebar-actions" ? "Настройки / Выйти"
            : item == "news" ? "Новости"
            : item == "main-actions" ? "Играть / Обновить / Моды"
            : item;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 64px;
        width: 58px;
        height: parent.height;
        text: root.pinned ? "закреплён" : "";
        color: Theme.text-muted;
        font-size: 12px;
        horizontal-alignment: end;
        vertical-alignment: center;
    }

    if !root.pinned: HorizontalLayout {
        x: parent.width - 126px;
        y: (parent.height - 24px) / 2;
        spacing: 2px;
        MiniButton { label: "←"; clicked => { root.move(root.item, "left"); } }
        MiniButton { label: "↑"; clicked => { root.move(root.item, "up"); } }
        MiniButton { label: "↓"; clicked => { root.move(root.item, "down"); } }
        MiniButton { label: "→"; clicked => { root.move(root.item, "right"); } }
    }
}

component LayoutZone inherits Rectangle {
    in property <string> title;
    in property <[string]> items;
    callback move(string, string);

    height: zone-layout.preferred-height + 20px;
    border-radius: Theme.radius-md;
    background: Theme.mode == "liquid-glass"
        ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
        : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
    border-width: 1px;
    border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
    drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
    drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
    drop-shadow-color: Theme.shadow;
    
    Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        border-radius: Theme.radius-pill;
        background: Theme.glass-highlight;
        visible: Theme.mode == "liquid-glass";
    }

    zone-layout := VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 700; }
        if root.items.length == 0: Text {
            text: "пусто";
            color: Theme.text-muted;
            font-size: 13px;
        }
        for item in root.items: LayoutRow {
            item: item;
            pinned: item == "server";
            move(i, direction) => { root.move(i, direction); }
        }
    }
}

component UserCard inherits Rectangle {
    in property <string> name;
    in property <string> host;
    in property <string> initial;
    in property <image> avatar;
    in property <bool> has-avatar: false;

    height: 64px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: Theme.radius-md;
            clip: true;
            background: @linear-gradient(135deg, Theme.gradient-start 0%, Theme.gradient-end 100%);
            Image {
                source: root.avatar;
                width: 100%;
                height: 100%;
                image-fit: cover;
                visible: root.has-avatar;
            }
            Text {
                text: root.initial;
                color: Theme.accent-text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: !root.has-avatar;
            }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text { text: root.name; color: Theme.text; font-size: 14px; font-weight: 600; }
            Text { text: root.host; color: Theme.text-muted; font-size: 14px; overflow: elide; }
        }
    }
}

component ProfileList inherits VerticalLayout {
    in property <[ProfileItem]> profiles;
    in property <int> selected-index;
    callback profile-clicked(int);

    spacing: 8px;

    Text {
        text: Texts.profiles;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for p in root.profiles: Rectangle {
                height: 62px;
                border-radius: Theme.radius-md;
                background: p.id == root.selected-index ? Theme.accent.with-alpha(0.22)
                    : row-area.has-hover ? Theme.surface-hover : transparent;
                border-width: 1px;
                border-color: p.id == root.selected-index ? Theme.accent : transparent;
                animate background { duration: 140ms; easing: ease-out; }
                animate border-color { duration: 140ms; }

                row-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(p.id); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-hover;
                        clip: true;
                        Text {
                            text: p.initial;
                            color: Theme.text-muted;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: !p.has-icon;
                        }
                        Image {
                            source: p.icon;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: p.display-name;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: p.subtitle;
                            color: Theme.text-muted;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

component CountdownCard inherits Rectangle {
    in property <string> text;

    height: 124px;
    border-radius: Theme.radius-lg;
    background: Theme.mode == "liquid-glass"
        ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
        : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
    border-width: 1px;
    border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
    drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
    drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
    drop-shadow-color: Theme.shadow;
    
    Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        border-radius: Theme.radius-pill;
        background: Theme.glass-highlight;
        visible: Theme.mode == "liquid-glass";
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 102px;
            height: 104px;
            border-radius: Theme.radius-md;
            clip: true;
            background: Theme.background-alt;
            Image {
                source: @image-url("../assets/nedrochabr.png");
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "НЕДРОЧАБРЬ";
                color: Theme.accent-hover;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 1.2px;
            }
            Text {
                text: root.text;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

component SidebarActions inherits HorizontalLayout {
    callback settings-clicked();
    callback logout-clicked();

    spacing: 8px;
    ActionButton {
        label: Texts.settings;
        icon: ThemeIcons.settings;
        has-icon: ThemeIcons.has-settings;
        clicked => { root.settings-clicked(); }
    }
    ActionButton {
        label: Texts.logout;
        clicked => { root.logout-clicked(); }
    }
}

component NewsBlock inherits VerticalLayout {
    in property <[NewsItem]> news;

    spacing: 8px;
    Text {
        text: Texts.news;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            for n in root.news: Rectangle {
                height: news-layout.preferred-height + 28px;
                border-radius: Theme.radius-md;
                background: Theme.mode == "liquid-glass"
                    ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                    : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                border-width: 1px;
                border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                drop-shadow-color: Theme.shadow;
                
                Rectangle {
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: 1px;
                    border-radius: Theme.radius-pill;
                    background: Theme.glass-highlight;
                    visible: Theme.mode == "liquid-glass";
                }
                news-layout := VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: n.title; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: n.body; color: Theme.text-muted; font-size: 14px; wrap: word-wrap; }
                    Text {
                        text: n.date;
                        color: Theme.text-muted;
                        font-size: 14px;
                        visible: !n.date.is-empty;
                    }
                }
            }
        }
    }
}

component MainActions inherits HorizontalLayout {
    in property <bool> can-play: false;
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();

    spacing: 14px;
    ActionButton {
        label: Texts.play;
        primary: true;
        available: root.can-play;
        icon: ThemeIcons.play;
        has-icon: ThemeIcons.has-play;
        width: 220px;
        height: 52px;
        clicked => { root.play-clicked(); }
    }
    ActionButton {
        label: Texts.refresh;
        icon: ThemeIcons.refresh;
        has-icon: ThemeIcons.has-refresh;
        width: 130px;
        height: 52px;
        clicked => { root.refresh-clicked(); }
    }
    ActionButton {
        label: Texts.mods;
        icon: ThemeIcons.mods;
        has-icon: ThemeIcons.has-mods;
        width: 110px;
        height: 52px;
        clicked => { root.mods-clicked(); }
    }
    Rectangle { horizontal-stretch: 1; }
}

component ZoneItem inherits Rectangle {
    in property <string> item;
    in property <[ProfileItem]> profiles;
    in property <int> selected-index;
    in property <string> user-name;
    in property <string> user-host;
    in property <string> user-initial;
    in property <image> user-avatar;
    in property <bool> has-avatar: false;
    in property <string> countdown-text;
    in property <[NewsItem]> news;
    in property <bool> can-play: false;
    callback profile-clicked(int);
    callback settings-clicked();
    callback logout-clicked();
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();

    height: item == "user" ? 64px
        : item == "profiles" ? 200px
        : item == "countdown" ? 124px
        : item == "sidebar-actions" ? 44px
        : item == "news" ? 220px
        : item == "main-actions" ? 52px
        : 0px;

    if item == "user": UserCard {
        width: 100%;
        height: 100%;
        name: root.user-name;
        host: root.user-host;
        initial: root.user-initial;
        avatar: root.user-avatar;
        has-avatar: root.has-avatar;
    }
    if item == "profiles": ProfileList {
        width: 100%;
        height: 100%;
        profiles: root.profiles;
        selected-index: root.selected-index;
        profile-clicked(id) => { root.profile-clicked(id); }
    }
    if item == "countdown": CountdownCard {
        width: 100%;
        height: 100%;
        text: root.countdown-text;
    }
    if item == "sidebar-actions": SidebarActions {
        width: 100%;
        height: 100%;
        settings-clicked => { root.settings-clicked(); }
        logout-clicked => { root.logout-clicked(); }
    }
    if item == "news": NewsBlock {
        width: 100%;
        height: 100%;
        news: root.news;
    }
    if item == "main-actions": MainActions {
        width: 100%;
        height: 100%;
        can-play: root.can-play;
        play-clicked => { root.play-clicked(); }
        refresh-clicked => { root.refresh-clicked(); }
        mods-clicked => { root.mods-clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: Theme.radius-md;
    background: checked ? Theme.accent : Theme.surface-hover;

    Rectangle {
        width: 20px;
        height: 20px;
        y: 3px;
        x: root.checked ? root.width - 23px : 3px;
        border-radius: Theme.radius-md;
        background: Theme.accent-text;
        animate x { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component AppWindow inherits Window {
    title: Texts.app-title;
    preferred-width: 1180px;
    preferred-height: 640px;
    min-width: 1080px;
    min-height: 620px;
    icon: @image-url("../assets/logo.png");
    background: Theme.background;
    no-frame: true;
    resize-border-width: 6px;
    default-font-family: Theme.font-family;
    // Regular 400 shimmers on the dark background at 14 px; SemiBold reads
    // cleaner without looking like a heading.
    default-font-weight: Theme.base-font-weight;

    // ---- login / global state -------------------------------------------
    in-out property <int> screen: 0;
    in-out property <bool> splash: true;
    in-out property <float> splash-progress: 0;
    in-out property <bool> window-maximized: false;
    in-out property <float> screen-opacity: 1;
    in-out property <string> app-version: "";
    in-out property <string> login: "";
    in-out property <string> password: "";
    in-out property <string> error-text: "";
    in-out property <bool> busy: false;
    in-out property <bool> show-2fa: false;
    in-out property <string> twofa: "";
    in-out property <int> server-index: 0;
    in-out property <bool> pl1-available: false;
    in-out property <string> server-label: "RU-2";
    in-out property <string> server-host-label: "";
    in-out property <string> background-effect: "none";
    in-out property <string> set-background-effect: "none";
    in-out property <[ThemeOption]> themes: [];
    in-out property <string> set-theme: "dark";
    in-out property <string> set-theme-mode: "base";
    in-out property <[string]> layout-sidebar-left: [];
    in-out property <[string]> layout-sidebar-right: [];
    in-out property <[string]> layout-header: [];
    in-out property <[string]> layout-content-top: [];
    in-out property <[string]> layout-content-bottom: [];
    in-out property <[string]> layout-footer: [];
    in-out property <bool> server-menu-open: false;
    in-out property <bool> is-kydasay: false;
    in-out property <bool> startup-ready: false;
    in-out property <string> countdown-text: "";
    in-out property <string> main-status: "";

    // ---- main ------------------------------------------------------------
    in-out property <string> user-name: "";
    in-out property <string> user-initial: "?";
    in-out property <image> user-avatar;
    in-out property <bool> has-avatar: false;
    in-out property <[ProfileItem]> profiles: [];
    in-out property <int> selected-index: -1;
    in-out property <string> selected-title: "Профиль не выбран";
    in-out property <string> selected-description: "";
    in-out property <string> selected-version: "";
    in-out property <string> selected-online: "";
    in-out property <image> selected-icon;
    in-out property <[NewsItem]> news: [];
    in-out property <[ModItem]> mods: [];
    in-out property <int> mods-enabled: 0;
    in-out property <int> mods-total: 0;
    in-out property <bool> can-play: false;

    in-out property <bool> progress-visible: false;
    in-out property <float> progress-value: 0;
    in-out property <string> progress-title: "";
    in-out property <string> progress-text: "";
    in-out property <string> progress-speed: "";

    in-out property <string> backend-mode: "";
    in-out property <bool> backend-mode-visible: false;
    in-out property <bool> backend-mode-expanded: true;
    in-out property <color> backend-mode-color: Theme.success;

    // ---- settings --------------------------------------------------------
    in-out property <string> set-install-dir: "";
    in-out property <int> set-xms: 2048;
    in-out property <int> set-xmx: 8192;
    in-out property <string> set-width-text: "900";
    in-out property <string> set-height-text: "600";
    in-out property <bool> set-fullscreen: false;
    in-out property <string> set-custom-jvm: "";

    in-out property <bool> set-send-hwid: true;
    in-out property <bool> set-sounds: true;
    in-out property <bool> set-hide-on-launch: true;
    in-out property <int> max-ram: 16384;
    in-out property <string> settings-status: "";

    in-out property <string> mirror-key: "";
    in-out property <string> mirror-mode: "";
    in-out property <string> mirror-upstream: "";
    in-out property <bool> mirror-can-control: false;
    in-out property <bool> mirror-tor: false;
    in-out property <bool> mirror-tor-available: false;
    in-out property <[SelfTestItem]> selftest: [];
    in-out property <string> selftest-summary: "";

    callback login-clicked();
    callback verify-clicked();
    callback offline-clicked();
    callback hwid-toggled(bool);
    callback logout-clicked();
    callback settings-clicked();
    callback back-clicked();
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();
    callback mods-refresh-clicked();
    callback mod-toggled(int, bool);
    callback server-clicked(int);
    callback profile-clicked(int);
    callback save-settings-clicked();
    callback check-backend-clicked();
    callback adjust-xms(int);
    callback adjust-xmx(int);
    callback mirror-save-key();
    callback mirror-clear-key();
    callback mirror-mode-clicked(string);
    callback mirror-tor-toggled(bool);
    callback selftest-clicked();
    callback theme-clicked(string);
    callback theme-mode-clicked(string);
    callback refresh-accent-clicked();
    callback themes-refresh-clicked();
    callback themes-open-folder-clicked();
    callback theme-reset-clicked();
    callback layout-move(string, string);
    callback layout-reset-clicked();
    callback maximize-clicked();

    // =====================================================================
    // LOGIN
    // =====================================================================
    if screen == 0: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: Theme.mode == "liquid-glass" ? 0.65 : 0.4;
        }

        Rectangle {
            background: Theme.mode == "liquid-glass"
                ? @linear-gradient(180deg, Theme.gradient-start.with-alpha(0.22) 0%, Theme.background.with-alpha(0.50) 55%, Theme.background.with-alpha(0.72) 100%)
                : @linear-gradient(180deg, Theme.background.with-alpha(0.8) 0%, Theme.background.with-alpha(0.94) 55%, Theme.background 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                width: 440px;
                spacing: 18px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Image {
                        source: @image-url("../assets/logo.svg");
                        width: 44px;
                        height: 44px;
                    }
                    Text {
                        text: "Vestalis";
                        color: Theme.text;
                        font-size: 40px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Femboy Edition";
                        color: Theme.accent-hover;
                        font-size: 14px;
                        vertical-alignment: bottom;
                    }
                }

                Rectangle {
                    height: root.show-2fa ? 590px : 485px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface.with-alpha(0.95);
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 12px;

                        Text {
                            text: Texts.login-title;
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        Text {
                            text: Texts.login-subtitle;
                            color: Theme.text-muted;
                            font-size: 14px;
                        }

                        Rectangle { height: 4px; }

                        TextField {
                            text <=> root.login;
                            placeholder: "Логин";
                            accepted => { root.login-clicked(); }
                        }
                        TextField {
                            text <=> root.password;
                            placeholder: "Пароль";
                            password: true;
                            accepted => { root.login-clicked(); }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Toggle {
                                checked: root.set-send-hwid;
                                toggled(v) => { root.set-send-hwid = v; root.hwid-toggled(v); }
                            }
                            Text {
                                text: "Отправлять HWID";
                                color: Theme.text-muted;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.show-2fa: VerticalLayout {
                            spacing: 8px;
                            TextField {
                                text <=> root.twofa;
                                placeholder: "Код двухфакторной аутентификации";
                                accepted => { root.verify-clicked(); }
                            }
                            ActionButton {
                                label: root.busy ? "Проверка…" : "Подтвердить код";
                                primary: true;
                                available: !root.busy;
                                clicked => { root.verify-clicked(); }
                            }
                        }

                        Text {
                            text: root.error-text;
                            color: Theme.danger;
                            font-size: 14px;
                            wrap: word-wrap;
                            visible: !root.error-text.is-empty;
                        }

                        Rectangle { vertical-stretch: 1; }

                        ActionButton {
                            label: root.busy ? "Подключение…" : Texts.login-submit;
                            primary: true;
                            available: !root.busy;
                            clicked => { root.login-clicked(); }
                        }
                        ActionButton {
                            label: Texts.login-offline;
                            available: !root.busy;
                            clicked => { root.offline-clicked(); }
                        }
                    }
                }

                Text {
                    text: "v" + root.app-version;
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MAIN
    // =====================================================================
    if screen == 1: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: Theme.mode == "liquid-glass" ? 0.5 : 0.22;
        }
        Rectangle {
            background: Theme.mode == "liquid-glass"
                ? @linear-gradient(120deg, Theme.gradient-start.with-alpha(0.25) 0%, Theme.background.with-alpha(0.52) 55%, Theme.gradient-end.with-alpha(0.28) 100%)
                : @linear-gradient(120deg, Theme.background.with-alpha(0.96) 0%, Theme.background.with-alpha(0.85) 55%, Theme.background.with-alpha(0.95) 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            spacing: 0px;

            // ---- sidebar ----
            Rectangle {
                width: 316px;
                background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface-low : Theme.background-alt.with-alpha(0.95));
                border-width: 0px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            source: @image-url("../assets/logo.svg");
                            width: 34px;
                            height: 34px;
                        }
                        Text {
                            text: "Vestalis";
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Texts.app-subtitle;
                            color: Theme.accent-hover;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 14px;
                        for item in root.layout-sidebar-left: ZoneItem {
                            item: item;
                            vertical-stretch: item == "profiles" ? 1 : 0;
                            profiles: root.profiles;
                            selected-index: root.selected-index;
                            user-name: root.user-name;
                            user-host: root.server-host-label;
                            user-initial: root.user-initial;
                            user-avatar: root.user-avatar;
                            has-avatar: root.has-avatar;
                            countdown-text: root.countdown-text;
                            news: root.news;
                            can-play: root.can-play;
                            profile-clicked(id) => { root.profile-clicked(id); }
                            settings-clicked => { root.settings-clicked(); }
                            logout-clicked => { root.logout-clicked(); }
                            play-clicked => { root.play-clicked(); }
                            refresh-clicked => { root.refresh-clicked(); }
                            mods-clicked => { root.mods-clicked(); }
                        }
                    }
                }
            }

            // ---- content ----
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 28px;
                spacing: 12px;

                for item in root.layout-header: ZoneItem {
                    item: item;
                    profiles: root.profiles;
                    selected-index: root.selected-index;
                    user-name: root.user-name;
                    user-host: root.server-host-label;
                    user-initial: root.user-initial;
                    user-avatar: root.user-avatar;
                    has-avatar: root.has-avatar;
                    countdown-text: root.countdown-text;
                    news: root.news;
                    can-play: root.can-play;
                    profile-clicked(id) => { root.profile-clicked(id); }
                    settings-clicked => { root.settings-clicked(); }
                    logout-clicked => { root.logout-clicked(); }
                    play-clicked => { root.play-clicked(); }
                    refresh-clicked => { root.refresh-clicked(); }
                    mods-clicked => { root.mods-clicked(); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 26px;
                        width: version-text.preferred-width + 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        visible: !root.selected-version.is-empty;
                        version-text := Text {
                            text: root.selected-version;
                            color: Theme.text-muted;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        width: online-text.preferred-width + 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.success.with-alpha(0.12);
                        border-width: 1px;
                        border-color: Theme.success.with-alpha(0.25);
                        visible: !root.selected-online.is-empty;
                        online-text := Text {
                            text: root.selected-online;
                            color: Theme.success;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: root.backend-mode-expanded ? 26px : 16px;
                        width: root.backend-mode-expanded ? mode-text.preferred-width + 28px : 16px;
                        border-radius: root.backend-mode-expanded ? Theme.radius-md : Theme.radius-sm;
                        background: root.backend-mode-color;
                        visible: root.backend-mode-visible;
                        animate width { duration: 220ms; easing: ease-out; }
                        animate height { duration: 220ms; easing: ease-out; }
                        animate border-radius { duration: 220ms; }
                        animate background { duration: 220ms; }

                        mode-text := Text {
                            text: root.backend-mode;
                            color: Theme.accent-text;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: root.backend-mode-expanded;
                            opacity: root.backend-mode-expanded ? 1 : 0;
                            animate opacity { duration: 160ms; }
                        }
                    }
                }

                Text {
                    text: root.selected-title;
                    color: Theme.text;
                    font-size: 40px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.selected-description;
                    color: Theme.text-muted;
                    font-size: 14px;
                    wrap: word-wrap;
                    max-height: 58px;
                    overflow: elide;
                }

                Rectangle { height: 8px; }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    for item in root.layout-content-top: ZoneItem {
                        item: item;
                        vertical-stretch: item == "news" ? 1 : 0;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                    }
                }

                if root.progress-visible: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.progress-title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.progress-speed;
                            color: Theme.accent-hover;
                            font-size: 14px;
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: Theme.radius-xs;
                        background: Theme.border;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.progress-value;
                            height: 100%;
                            border-radius: Theme.radius-xs;
                            background: @linear-gradient(90deg, Theme.gradient-start 0%, Theme.accent-hover 100%);
                            animate width { duration: 160ms; easing: ease-out; }
                        }
                    }
                    Text {
                        text: root.progress-text;
                        color: Theme.text-muted;
                        font-size: 14px;
                        overflow: elide;
                    }
                }

                if !root.main-status.is-empty: Text {
                    text: root.main-status;
                    color: Theme.success;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                if !root.error-text.is-empty: Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle { height: 2px; }

                for item in root.layout-content-bottom: ZoneItem {
                    item: item;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                }
                for item in root.layout-footer: ZoneItem {
                    item: item;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                }
            }

            if root.layout-sidebar-right.length > 0: Rectangle {
                width: 300px;
                background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface-low : Theme.background-alt.with-alpha(0.95));
                border-width: 0px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    for item in root.layout-sidebar-right: ZoneItem {
                        item: item;
                        vertical-stretch: item == "profiles" ? 1 : 0;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                    }
                }
            }
        }
    }

    // =====================================================================
    // SETTINGS
    // =====================================================================
    Rectangle {
        visible: screen == 2;
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: Theme.background;

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: Texts.back;
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: Texts.settings-title;
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.settings-status;
                    color: Theme.success;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    // ---- column 1 ----
                    VerticalLayout {
                        width: 50%;
                        spacing: 16px;

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: ram-layout.preferred-height + 40px;

                            ram-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Память"; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Сколько оперативной памяти выделять игре. Всего в системе: " + root.max-ram + " МБ.";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Минимум (Xms)"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xms(-512); } }
                                    Text {
                                        text: root.set-xms + " МБ";
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xms(512); } }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Максимум (Xmx)"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xmx(-1024); } }
                                    Text {
                                        text: root.set-xmx + " МБ";
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xmx(1024); } }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: jvm-layout.preferred-height + 40px;

                            jvm-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Дополнительные аргументы JVM"; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Флаги добавляются перед classpath. Флаги -Xms/-Xmx здесь игнорируются.";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                TextField {
                                    text <=> root.set-custom-jvm;
                                    placeholder: "-XX:+UseZGC -XX:+UnlockExperimentalVMOptions";
                                }
                            }
                        }
                    }

                    // ---- column 2 ----
                    VerticalLayout {
                        width: 50%;
                        spacing: 16px;

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: window-layout.preferred-height + 40px;

                            window-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Окно игры"; color: Theme.text; font-size: 17px; font-weight: 700; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Полноэкранный режим"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-fullscreen;
                                        toggled(v) => { root.set-fullscreen = v; }
                                    }
                                }

                                if !root.set-fullscreen: HorizontalLayout {
                                    spacing: 10px;
                                    TextField { text <=> root.set-width-text; numeric: true; horizontal-stretch: 1; }
                                    Text { text: "×"; color: Theme.text-muted; vertical-alignment: center; }
                                    TextField { text <=> root.set-height-text; numeric: true; horizontal-stretch: 1; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: "Скрывать лаунчер при запуске игры";
                                        color: Theme.text-muted;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Toggle {
                                        checked: root.set-hide-on-launch;
                                        toggled(v) => { root.set-hide-on-launch = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: launcher-layout.preferred-height + 40px;

                            launcher-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Лаунчер"; color: Theme.text; font-size: 17px; font-weight: 700; }

                                Text { text: "Папка установки"; color: Theme.text-muted; font-size: 14px; }
                                TextField {
                                    text <=> root.set-install-dir;
                                    placeholder: "%APPDATA%\\Vestalis";
                                }

                                Text { text: "Фон лаунчера"; color: Theme.text-muted; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Нет";
                                        primary: root.set-background-effect == "none";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "none"; root.background-effect = "none"; }
                                    }
                                    ActionButton {
                                        label: "Светлячки";
                                        primary: root.set-background-effect == "fireflies";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "fireflies"; root.background-effect = "fireflies"; }
                                    }
                                    ActionButton {
                                        label: "Листья";
                                        primary: root.set-background-effect == "leaves";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "leaves"; root.background-effect = "leaves"; }
                                    }
                                    ActionButton {
                                        label: "Снежинки";
                                        primary: root.set-background-effect == "snow";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "snow"; root.background-effect = "snow"; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Отправлять реальный HWID"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-send-hwid;
                                        toggled(v) => { root.set-send-hwid = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Звуки интерфейса"; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-sounds;
                                        toggled(v) => { root.set-sounds = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: theme-layout.preferred-height + 40px;

                            theme-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Оформление"; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Тема применяется сразу. Пользовательские темы берутся из папки themes рядом с state.json.";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                Text { text: "Режим оформления"; color: Theme.text-muted; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Base";
                                        primary: root.set-theme-mode == "base";
                                        width: 110px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "base"; root.theme-mode-clicked("base"); }
                                    }
                                    ActionButton {
                                        label: "Material 3";
                                        primary: root.set-theme-mode == "material3";
                                        width: 140px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "material3"; root.theme-mode-clicked("material3"); }
                                    }
                                    ActionButton {
                                        label: "Liquid Glass";
                                        primary: root.set-theme-mode == "liquid-glass";
                                        width: 150px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "liquid-glass"; root.theme-mode-clicked("liquid-glass"); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Material 3 использует цвет Windows; при недоступности — accent темы.";
                                        color: Theme.text-muted;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    ActionButton {
                                        label: "Взять цвет Windows";
                                        width: 190px;
                                        height: 36px;
                                        clicked => { root.refresh-accent-clicked(); }
                                    }
                                }

                                for t in root.themes: Rectangle {
                                    height: 46px;
                                    border-radius: Theme.radius-md;
                                    background: root.set-theme == t.name
                                        ? Theme.accent.with-alpha(0.16)
                                        : Theme.surface-hover;
                                    border-width: 1px;
                                    border-color: root.set-theme == t.name ? Theme.accent : Theme.border;

                                    HorizontalLayout {
                                        width: parent.width;
                                        padding: 10px;
                                        spacing: 10px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.accent;
                                        }
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.surface;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                        }
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.text;
                                        }

                                        Text {
                                            text: t.name;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: t.builtin ? "встроенная" : "своя";
                                            color: Theme.text-muted;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.set-theme = t.name;
                                            root.theme-clicked(t.name);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Обновить темы";
                                        width: 150px;
                                        height: 38px;
                                        clicked => { root.themes-refresh-clicked(); }
                                    }
                                    ActionButton {
                                        label: "Открыть папку тем";
                                        width: 175px;
                                        height: 38px;
                                        clicked => { root.themes-open-folder-clicked(); }
                                    }
                                    ActionButton {
                                        label: "Сбросить тему";
                                        width: 150px;
                                        height: 38px;
                                        clicked => {
                                            root.set-theme = "dark";
                                            root.theme-reset-clicked();
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: layout-card.preferred-height + 40px;

                            layout-card := VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Text { text: "Layout"; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Зоны главного экрана. Стрелки перемещают блок внутри зоны и между зонами; выбор сервера закреплён в шапке.";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                LayoutZone {
                                    title: "Левый сайдбар";
                                    items: root.layout-sidebar-left;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                LayoutZone {
                                    title: "Правый сайдбар";
                                    items: root.layout-sidebar-right;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                LayoutZone {
                                    title: "Шапка";
                                    items: root.layout-header;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                LayoutZone {
                                    title: "Верх контента";
                                    items: root.layout-content-top;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                LayoutZone {
                                    title: "Низ контента";
                                    items: root.layout-content-bottom;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                LayoutZone {
                                    title: "Подвал";
                                    items: root.layout-footer;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                }
                                ActionButton {
                                    label: "Сбросить layout";
                                    width: 190px;
                                    height: 38px;
                                    clicked => { root.layout-reset-clicked(); }
                                }
                            }
                        }

                        Rectangle {
                            visible: root.server-index == 3 && root.is-kydasay;
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: mirror-layout.preferred-height + 40px;

                            mirror-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Сервисный доступ · PL-1"; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Ключ хранится локально и не входит в сборку. С ним доступны переключение режима, Tor и самодиагностика.";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                TextField {
                                    text <=> root.mirror-key;
                                    placeholder: "X-Mirror-Control-Key";
                                    password: true;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Сохранить ключ";
                                        width: 150px;
                                        clicked => { root.mirror-save-key(); }
                                    }
                                    ActionButton {
                                        label: "Удалить";
                                        width: 100px;
                                        clicked => { root.mirror-clear-key(); }
                                    }
                                }

                                Text {
                                    text: "Режим: " + (root.mirror-mode.is-empty ? "неизвестен" : root.mirror-mode)
                                        + (root.mirror-upstream.is-empty ? "" : " · upstream: " + root.mirror-upstream);
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                if root.mirror-can-control: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton {
                                            label: "Зеркало";
                                            width: 110px;
                                            primary: root.mirror-mode == "local";
                                            clicked => { root.mirror-mode-clicked("local"); }
                                        }
                                        ActionButton {
                                            label: "Прокси";
                                            width: 110px;
                                            primary: root.mirror-mode == "proxy";
                                            clicked => { root.mirror-mode-clicked("proxy"); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Запросы к основному бэкенду через Tor";
                                            color: Theme.text-muted;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            visible: root.mirror-tor-available;
                                        }
                                        Toggle {
                                            checked: root.mirror-tor;
                                            visible: root.mirror-tor-available;
                                            toggled(v) => { root.mirror-tor-toggled(v); }
                                        }
                                    }
                                    ActionButton {
                                        label: "Самодиагностика";
                                        width: 170px;
                                        clicked => { root.selftest-clicked(); }
                                    }
                                }

                                if !root.selftest-summary.is-empty: Text {
                                    text: root.selftest-summary;
                                    color: Theme.accent-hover;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                for row in root.selftest: Rectangle {
                                    height: row-layout.preferred-height + 16px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.background-alt;
                                    border-width: 1px;
                                    border-color: row.status == "ok" ? Theme.success.with-alpha(0.25)
                                        : row.status == "warn" ? Theme.warning.with-alpha(0.25) : Theme.danger.with-alpha(0.25);
                                    row-layout := HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: row.status == "ok" ? "ОК" : row.status == "warn" ? "ВНИМАНИЕ" : "ОШИБКА";
                                            color: row.status == "ok" ? Theme.success : row.status == "warn" ? Theme.warning : Theme.danger;
                                            font-size: 14px;
                                            font-weight: 700;
                                            width: 70px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.name;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            width: 140px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.message;
                                            color: Theme.text-muted;
                                            font-size: 14px;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: row.duration;
                                            color: Theme.text-muted;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: "Сохранить настройки";
                    primary: true;
                    width: 240px;
                    height: 48px;
                    clicked => { root.save-settings-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "v" + root.app-version;
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MODS
    // =====================================================================
    if screen == 3: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: Theme.background;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: Texts.back;
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: "Моды";
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.mods-enabled + " из " + root.mods-total + " включено";
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    label: "Обновить";
                    width: 130px;
                    clicked => { root.mods-refresh-clicked(); }
                }
            }

            Text {
                text: "Опциональные моды. Выключенные файлы хранятся с суффиксом .disabled.";
                color: Theme.text-muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            if root.mods-total == 0: Text {
                text: "Для этого профиля нет опциональных модов.";
                color: Theme.text-muted;
                font-size: 14px;
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for m in root.mods: Rectangle {
                        height: mod-row.preferred-height + 18px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface.with-alpha(Theme.card-opacity);
                        border-width: 1px;
                        border-color: m.enabled ? Theme.accent.with-alpha(0.25) : Theme.surface-hover;

                        mod-row := HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: m.description;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    visible: !m.description.is-empty;
                                }
                            }

                            Toggle {
                                checked: m.enabled;
                                toggled(v) => { root.mod-toggled(m.id, v); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Branded start screen. The real window is already behind it, so the
    // hand-over is instant once the first backend requests are in flight.
    if root.splash: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.18;
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;

            Rectangle { height: 90px; }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                Image {
                    source: @image-url("../assets/logo.svg");
                    width: 64px;
                    height: 64px;
                }
                Text {
                    text: "Vestalis";
                    color: Theme.text;
                    font-size: 56px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Femboy Edition";
                color: Theme.accent-hover;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Rectangle { height: 18px; }
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 260px;
                    height: 4px;
                    border-radius: Theme.radius-xs;
                    background: Theme.border;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.splash-progress;
                        height: 100%;
                        border-radius: Theme.radius-xs;
                        background: @linear-gradient(90deg, Theme.gradient-end 0%, Theme.accent-hover 50%, Theme.gradient-end 100%);
                    }
                }
            }
            Text {
                text: "Загрузка…";
                color: Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    // Custom title bar (the window uses no-frame).
    Rectangle {
        y: 0;
        width: 100%;
        height: 42px;
        background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface : Theme.background-alt.with-alpha(0.96));
        border-width: 0px;

        WindowMoveArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
                text: Texts.app-title;
                color: Theme.text-muted;
                font-size: 14px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 138px;
                height: 30px;
                border-radius: Theme.radius-pill;
                background: root.server-menu-open
                    ? Theme.surface-hover
                    : Theme.surface.with-alpha(0.85);
                border-width: 1px;
                border-color: root.server-menu-open ? Theme.accent : Theme.border;
                animate background { duration: 130ms; }
                animate border-color { duration: 130ms; }

                if ThemeIcons.has-server: Image {
                    x: 10px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    source: ThemeIcons.server;
                    image-fit: contain;
                }

                if !ThemeIcons.has-server: Rectangle {
                    x: 10px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: @linear-gradient(135deg, Theme.gradient-start 0%, Theme.gradient-end 100%);

                    Rectangle {
                        x: 4px;
                        y: 5px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.9;
                    }
                    Rectangle {
                        x: 4px;
                        y: 8.25px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.7;
                    }
                    Rectangle {
                        x: 4px;
                        y: 11.5px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.5;
                    }
                }

                Text {
                    x: 35px;
                    text: root.server-label;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if ThemeIcons.has-chevron: Image {
                    x: parent.width - 24px;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    source: ThemeIcons.chevron;
                    image-fit: contain;
                }

                if !ThemeIcons.has-chevron: Path {
                    x: parent.width - 22px;
                    y: (parent.height - 6px) / 2;
                    width: 9px;
                    height: 6px;
                    commands: "M 0 0 L 4.5 6 L 9 0";
                    stroke: root.server-menu-open ? Theme.accent : Theme.text-muted;
                    stroke-width: 1.5px;
                    fill: transparent;
                    transform-rotation: root.server-menu-open ? 180deg : 0deg;
                    animate transform-rotation { duration: 150ms; easing: ease-out; }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.server-menu-open = !root.server-menu-open; }
                }
            }

            CaptionButton {
                kind: "min";
                icon: ThemeIcons.minimize;
                has-icon: ThemeIcons.has-minimize;
                clicked => { root.minimized = true; }
            }
            CaptionButton {
                kind: root.window-maximized ? "restore" : "max";
                icon: root.window-maximized ? ThemeIcons.restore : ThemeIcons.maximize;
                has-icon: root.window-maximized ? ThemeIcons.has-restore : ThemeIcons.has-maximize;
                clicked => { root.maximize-clicked(); }
            }
            CaptionButton {
                kind: "close";
                icon: ThemeIcons.close;
                has-icon: ThemeIcons.has-close;
                clicked => { root.close(); }
            }
        }
    }

    if root.server-menu-open: Rectangle {
        y: 42px;
        width: 100%;
        height: root.height - 42px;
        background: transparent;

        TouchArea {
            clicked => { root.server-menu-open = false; }
        }
    }

    if root.server-menu-open: Rectangle {
        x: root.width - 276px;
        y: 46px;
        width: 172px;
        height: root.pl1-available ? 160px : 124px;
        border-radius: Theme.radius-lg;
        background: Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.surface.with-alpha(0.97);
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.shadow;
        
        Rectangle {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            height: 1px;
            border-radius: Theme.radius-pill;
            background: Theme.glass-highlight;
            visible: Theme.mode == "liquid-glass";
        }

        VerticalLayout {
            padding: 5px;
            spacing: 2px;
            ServerMenuItem {
                label: "RU-1";
                active: root.server-index == 0;
                clicked => { root.server-menu-open = false; root.server-clicked(0); }
            }
            ServerMenuItem {
                label: "RU-2";
                active: root.server-index == 1;
                clicked => { root.server-menu-open = false; root.server-clicked(1); }
            }
            ServerMenuItem {
                label: "EU-1";
                active: root.server-index == 2;
                clicked => { root.server-menu-open = false; root.server-clicked(2); }
            }
            if root.pl1-available: ServerMenuItem {
                label: "PL-1";
                active: root.server-index == 3;
                clicked => { root.server-menu-open = false; root.server-clicked(3); }
            }
        }
    }
}
