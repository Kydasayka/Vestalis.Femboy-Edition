// Ambient background effects, driven by Slint's animation clock so they do not
// need a Rust timer. Only the selected variant is instantiated.
component BackgroundEffect inherits Rectangle {
    in property <string> kind: "none";

    if kind == "fireflies": Rectangle {
        for i in 16: Rectangle {
            width: 3px + Math.mod(i, 3) * 1px;
            height: self.width;
            border-radius: Theme.radius-pill;
            background: Theme.warning;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.warning.with-alpha(0.8);
            opacity: 0.2 + 0.75 * abs(sin((animation-tick() / 1s * (18 + Math.mod(i, 6)) + i * 61) * 1deg));
            x: parent.width * (0.04 + Math.mod(i * 37 + 13, 90) / 100.0)
                + 24px * sin((animation-tick() / 1s * (7 + Math.mod(i, 5)) + i * 29) * 1deg);
            y: parent.height * (0.1 + Math.mod(i * 29 + 7, 78) / 100.0)
                + 18px * sin((animation-tick() / 1s * (10 + Math.mod(i, 4)) + i * 47) * 1deg);
        }
    }

    if kind == "leaves": Rectangle {
        for i in 18: Rectangle {
            width: 10px + Math.mod(i, 4) * 3px;
            height: self.width * 0.62;
            border-radius: Theme.radius-pill;
            background: Math.mod(i, 4) == 0 ? Theme.warning
                : Math.mod(i, 4) == 1 ? Theme.warning.darker(0.15)
                : Math.mod(i, 4) == 2 ? Theme.success
                : Theme.warning.darker(0.3);
            opacity: 0.55 + 0.35 * abs(sin((animation-tick() / 1s * (9 + Math.mod(i, 5)) + i * 23) * 1deg));
            transform-rotation: sin((animation-tick() / 1s * (24 + Math.mod(i, 5)) + i * 33) * 1deg) * 40deg + i * 17deg;
            x: parent.width * (0.02 + Math.mod(i * 41 + 7, 94) / 100.0)
                + (34px + Math.mod(i, 4) * 8px)
                    * sin((animation-tick() / 1s * (23 + Math.mod(i, 3) * 14) + i * 37) * 1deg);
            y: -28px + (parent.height + 56px)
                * Math.mod(animation-tick() + i * 1400ms, (9 + Math.mod(i, 7)) * 1s)
                / ((9 + Math.mod(i, 7)) * 1s);
        }
    }

    if kind == "snow": Rectangle {
        for i in 28: Rectangle {
            width: 2px + Math.mod(i, 4) * 1.2px;
            height: self.width;
            border-radius: Theme.radius-pill;
            background: Theme.text;
            opacity: 0.35 + 0.55 * abs(sin((animation-tick() / 1s * (10 + Math.mod(i, 7)) + i * 41) * 1deg));
            x: parent.width * (0.01 + Math.mod(i * 43 + 11, 97) / 100.0)
                + (16px + Math.mod(i, 5) * 7px)
                    * sin((animation-tick() / 1s * (18 + Math.mod(i, 4) * 11) + i * 53) * 1deg);
            y: -12px + (parent.height + 24px)
                * Math.mod(animation-tick() + i * 900ms, (7 + Math.mod(i, 8)) * 1s)
                / ((7 + Math.mod(i, 8)) * 1s);
        }
    }
}

// Soft colour fields behind Liquid Glass panels. Slint cannot blur the actual
// backdrop, so these blurred blobs provide the colour bleed that makes the
// translucent panels read as glass.
component GlassBackdrop inherits Rectangle {
    Rectangle {
        x: parent.width * 0.05;
        y: parent.height * 0.10;
        width: 340px;
        height: 340px;
        border-radius: Theme.radius-pill;
        background: Theme.gradient-start.with-alpha(0.30);
        drop-shadow-blur: 130px;
        drop-shadow-color: Theme.gradient-start.with-alpha(0.55);
    }
    Rectangle {
        x: parent.width * 0.62;
        y: parent.height * 0.42;
        width: 420px;
        height: 420px;
        border-radius: Theme.radius-pill;
        background: Theme.gradient-end.with-alpha(0.28);
        drop-shadow-blur: 150px;
        drop-shadow-color: Theme.gradient-end.with-alpha(0.50);
    }
    Rectangle {
        x: parent.width * 0.35;
        y: parent.height * 0.65;
        width: 280px;
        height: 280px;
        border-radius: Theme.radius-pill;
        background: Theme.tertiary.with-alpha(0.18);
        drop-shadow-blur: 120px;
        drop-shadow-color: Theme.tertiary.with-alpha(0.35);
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    height: 44px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: !available
        ? Theme.border
        : Theme.mode == "liquid-glass"
            ? Theme.glass-border
            : (primary ? Theme.accent-hover : Theme.border);
    background: !available ? Theme.background-alt
        : area.has-hover
            ? (primary ? Theme.accent-hover : (Theme.mode == "liquid-glass" ? Theme.glass-highlight : Theme.surface-hover))
            : (primary
                ? (Theme.mode == "liquid-glass" ? Theme.accent.with-alpha(0.86) : Theme.accent)
                : (Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.surface));

    area := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if root.has-icon: Image {
        x: 12px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }

    Text {
        x: root.has-icon ? 34px : 0;
        width: root.has-icon ? parent.width - 40px : parent.width;
        height: parent.height;
        text: root.label;
        color: root.available ? (root.primary ? Theme.accent-text : Theme.text) : Theme.text-muted;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: root.has-icon ? left : center;
        vertical-alignment: center;
    }
}

component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> numeric: false;
    callback accepted();
    callback edited(string);

    height: 46px;
    border-radius: Theme.radius-md;
    background: Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.background-alt;
    border-width: 1px;
    border-color: input.has-focus
        ? Theme.accent
        : (Theme.mode == "liquid-glass" ? Theme.glass-border : Theme.border);

    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : (root.numeric ? InputType.number : InputType.text);
        selection-background-color: Theme.accent;
        accepted => { root.accepted(); }
        edited => { root.edited(input.text); }

        // Slint's built-in shortcut lookup can miss Ctrl+V on a non-English
        // layout; accept both the Latin and Cyrillic V keys.
        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М") {
                self.paste();
                return accept;
            }
            return reject;
        }
    }

    if input.text.is-empty && !root.placeholder.is-empty: Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component CaptionButton inherits Rectangle {
    in property <string> kind: "min";
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    width: 38px;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: area.has-hover
        ? (kind == "close" ? Theme.danger : Theme.surface-hover)
        : transparent;

    property <color> icon-color: area.has-hover
        ? (kind == "close" ? Theme.accent-text : Theme.text)
        : Theme.text-muted;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if has-icon: Image {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }

    if !has-icon && kind == "min": Rectangle {
        width: 11px;
        height: 1.5px;
        x: (parent.width - 11px) / 2;
        y: (parent.height - 1.5px) / 2;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }

    if !has-icon && kind == "max": Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        border-width: 1.5px;
        border-color: icon-color;
        border-radius: Theme.radius-xs;
        background: transparent;
    }

    if !has-icon && kind == "restore": Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: 9px;
            height: 9px;
            x: (parent.width - 11px) / 2;
            y: (parent.height - 11px) / 2;
            border-width: 1.5px;
            border-color: icon-color;
            border-radius: Theme.radius-xs;
            background: transparent;
        }
        Rectangle {
            width: 9px;
            height: 9px;
            x: (parent.width - 11px) / 2 + 3px;
            y: (parent.height - 11px) / 2 + 3px;
            border-width: 1.5px;
            border-color: icon-color;
            border-radius: Theme.radius-xs;
            background: area.has-hover ? Theme.surface-hover : Theme.background-alt;
        }
    }

    if !has-icon && kind == "close": Rectangle {
        width: 13px;
        height: 1.5px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 1.5px) / 2;
        transform-rotation: 45deg;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }
    if !has-icon && kind == "close": Rectangle {
        width: 13px;
        height: 1.5px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 1.5px) / 2;
        transform-rotation: -45deg;
        border-radius: Theme.radius-xs;
        background: icon-color;
    }
}

component ServerMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <string> badge: "";
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: root.disabled
        ? transparent
        : active
            ? Theme.accent.with-alpha(0.18)
            : (area.has-hover ? Theme.surface-hover : transparent);

    Rectangle {
        width: 3px;
        height: 18px;
        x: 1px;
        y: (parent.height - 18px) / 2;
        border-radius: Theme.radius-pill;
        background: Theme.accent;
        visible: root.active && !root.disabled;
    }

    Text {
        x: 14px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 14px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        opacity: root.disabled ? 0.45 : 1;
    }

    if !root.badge.is-empty: Text {
        x: parent.width - 58px;
        width: 48px;
        height: parent.height;
        text: root.badge;
        color: Theme.warning;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: end;
        vertical-alignment: center;
        opacity: root.disabled ? 0.7 : 1;
    }

    area := TouchArea {
        enabled: !root.disabled;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MiniButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 26px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: area.has-hover ? Theme.surface-hover : transparent;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LayoutRow inherits Rectangle {
    in property <string> item;
    in property <bool> pinned: false;
    in property <bool> hidden: false;
    callback move(string, string);
    callback drop(string, string);

    height: 34px;
    property <bool> can-drag: true;

    if !root.pinned: DragArea {
        data: LayoutDrag.payload;
        allow-move: true;

        // DragArea has no drag-started callback; the press prepares the
        // payload used by the next drag.
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down || event.kind == PointerEventKind.move {
                    LayoutDrag.begin(root.item);
                }
            }
        }
    }

    if !root.pinned: DropArea {
        can-drop(event) => {
            return LayoutDrag.transfer-text(event.data).is-empty ? DragAction.none : DragAction.move;
        }
        dropped(event) => {
            root.drop(LayoutDrag.transfer-text(event.data), root.item);
            return DragAction.move;
        }
    }

    Text {
        x: 8px;
        width: parent.width - 312px;
        height: parent.height;
        opacity: root.hidden ? 0.45 : 1;
        text: item == "server" ? Texts.layout-server
            : item == "user" ? Texts.layout-user
            : item == "profiles" ? Texts.layout-profiles-item
            : item == "countdown" ? Texts.layout-countdown
            : item == "sidebar-actions" ? Texts.layout-sidebar-actions
            : item == "news" ? Texts.layout-news
            : item == "main-actions" ? Texts.layout-main-actions
            : item;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 64px;
        width: 58px;
        height: parent.height;
        text: root.pinned ? Texts.layout-pinned : "";
        color: Theme.text-muted;
        font-size: 12px;
        horizontal-alignment: end;
        vertical-alignment: center;
    }

    if !root.pinned: HorizontalLayout {
        x: parent.width - 304px;
        y: (parent.height - 24px) / 2;
        spacing: 2px;

        MiniButton {
            label: "−";
            clicked => {
                LayoutState.resize-block(root.item, LayoutState.block-height(root.item) - 12);
            }
        }
        Text {
            width: 44px;
            height: 24px;
            text: "\{LayoutState.block-height(root.item)}";
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        MiniButton {
            label: "+";
            clicked => {
                LayoutState.resize-block(root.item, LayoutState.block-height(root.item) + 12);
            }
        }
    }

    if !root.pinned: Rectangle {
        x: parent.width - 198px;
        y: (parent.height - 24px) / 2;
        width: 64px;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: visibility-area.has-hover ? Theme.surface-hover : transparent;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.hidden ? Texts.layout-hidden : Texts.layout-visible;
            color: root.hidden ? Theme.warning : Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        visibility-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { LayoutState.toggle-hidden(root.item, !root.hidden); }
        }
    }

    if !root.pinned: HorizontalLayout {
        x: parent.width - 126px;
        y: (parent.height - 24px) / 2;
        spacing: 2px;
        MiniButton { label: "←"; clicked => { root.move(root.item, "left"); } }
        MiniButton { label: "↑"; clicked => { root.move(root.item, "up"); } }
        MiniButton { label: "↓"; clicked => { root.move(root.item, "down"); } }
        MiniButton { label: "→"; clicked => { root.move(root.item, "right"); } }
    }
}

component LayoutZone inherits Rectangle {
    in property <string> title;
    in property <string> zone;
    in property <[string]> items;
    callback move(string, string);
    callback drop(string, string, string);

    height: zone-layout.preferred-height + 20px;
    property <bool> drop-hover: false;
    border-radius: Theme.radius-md;
    background: Theme.mode == "liquid-glass"
        ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
        : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
    border-width: 1px;
    border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
    drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
    drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
    drop-shadow-color: Theme.shadow;
    
    Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        border-radius: Theme.radius-pill;
        background: Theme.glass-highlight;
        visible: Theme.mode == "liquid-glass";
    }

    // Appends to the zone. Rows are drawn on top and handle insert-before drops.
    DropArea {
        enabled: true;
        can-drop(event) => {
            return LayoutDrag.transfer-text(event.data).is-empty ? DragAction.none : DragAction.move;
        }
        dropped(event) => {
            root.drop(LayoutDrag.transfer-text(event.data), root.zone, "");
            return DragAction.move;
        }
    }

    zone-layout := VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 700; }
        if root.items.length == 0: Text {
            text: Texts.layout-empty;
            color: Theme.text-muted;
            font-size: 13px;
        }
        for item in root.items: LayoutRow {
            item: item;
            pinned: item == "server";
            hidden: LayoutState.is-hidden(item);
            move(i, direction) => { root.move(i, direction); }
            drop(dragged, before) => { root.drop(dragged, root.zone, before); }
        }
    }
}

component UserCard inherits Rectangle {
    in property <string> name;
    in property <string> host;
    in property <string> initial;
    in property <image> avatar;
    in property <bool> has-avatar: false;

    height: 64px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: Theme.radius-md;
            clip: true;
            background: @linear-gradient(135deg, Theme.gradient-start 0%, Theme.gradient-end 100%);
            Image {
                source: root.avatar;
                width: 100%;
                height: 100%;
                image-fit: cover;
                visible: root.has-avatar;
            }
            Text {
                text: root.initial;
                color: Theme.accent-text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: !root.has-avatar;
            }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text { text: root.name; color: Theme.text; font-size: 14px; font-weight: 600; }
            Text { text: root.host; color: Theme.text-muted; font-size: 14px; overflow: elide; }
        }
    }
}

component ProfileList inherits VerticalLayout {
    in property <[ProfileItem]> profiles;
    in property <int> selected-index;
    callback profile-clicked(int);

    spacing: 8px;

    Text {
        text: Texts.profiles;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    TextField {
        text <=> ProfileFilter.text;
        placeholder: Texts.profiles-search;
        height: 34px;
        edited(value) => { ProfileFilter.changed(value); }
    }

    if root.profiles.length == 0: Text {
        text: ProfileFilter.text.is-empty ? Texts.profiles-empty : Texts.profiles-not-found;
        color: Theme.text-muted;
        font-size: 13px;
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            for p in root.profiles: Rectangle {
                height: 62px;
                border-radius: Theme.radius-md;
                background: p.id == root.selected-index
                    ? (Theme.mode == "material3" ? Theme.primary-container : Theme.accent.with-alpha(0.22))
                    : row-area.has-hover ? Theme.surface-hover : transparent;
                border-width: 1px;
                border-color: p.id == root.selected-index ? Theme.accent : transparent;
                animate border-color { duration: 140ms; }

                row-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(p.id); }
                }

                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-hover;
                        clip: true;
                        Text {
                            text: p.initial;
                            color: Theme.text-muted;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: !p.has-icon;
                        }
                        Image {
                            source: p.icon;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: p.display-name;
                            color: p.id == root.selected-index && Theme.mode == "material3"
                                ? Theme.on-primary-container
                                : Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: p.subtitle;
                            color: Theme.text-muted;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

component CountdownCard inherits Rectangle {
    in property <string> text;

    height: 124px;
    border-radius: Theme.radius-lg;
    background: Theme.mode == "liquid-glass"
        ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
        : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
    border-width: 1px;
    border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
    drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
    drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
    drop-shadow-color: Theme.shadow;
    
    Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 1px;
        border-radius: Theme.radius-pill;
        background: Theme.glass-highlight;
        visible: Theme.mode == "liquid-glass";
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 102px;
            height: 104px;
            border-radius: Theme.radius-md;
            clip: true;
            background: Theme.background-alt;
            Image {
                source: @image-url("../assets/nedrochabr.png");
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "НЕДРОЧАБРЬ";
                color: Theme.accent-hover;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 1.2px;
            }
            Text {
                text: root.text;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

component SidebarActions inherits HorizontalLayout {
    callback settings-clicked();
    callback logout-clicked();

    spacing: 8px;
    ActionButton {
        label: Texts.settings;
        icon: ThemeIcons.settings;
        has-icon: ThemeIcons.has-settings;
        clicked => { root.settings-clicked(); }
    }
    ActionButton {
        label: Texts.logout;
        clicked => { root.logout-clicked(); }
    }
}

component NewsBlock inherits VerticalLayout {
    in property <[NewsItem]> news;

    spacing: 8px;
    Text {
        text: Texts.news;
        color: Theme.text-muted;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            for n in root.news: Rectangle {
                height: news-layout.preferred-height + 28px;
                border-radius: Theme.radius-md;
                background: Theme.mode == "liquid-glass"
                    ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                    : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                border-width: 1px;
                border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                drop-shadow-color: Theme.shadow;
                
                Rectangle {
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: 1px;
                    border-radius: Theme.radius-pill;
                    background: Theme.glass-highlight;
                    visible: Theme.mode == "liquid-glass";
                }
                news-layout := VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: n.title; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: n.body; color: Theme.text-muted; font-size: 14px; wrap: word-wrap; }
                    Text {
                        text: n.date;
                        color: Theme.text-muted;
                        font-size: 14px;
                        visible: !n.date.is-empty;
                    }
                }
            }
        }
    }
}

component MainActions inherits HorizontalLayout {
    in property <bool> can-play: false;
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();

    spacing: 14px;
    ActionButton {
        label: Texts.play;
        primary: true;
        available: root.can-play;
        icon: ThemeIcons.play;
        has-icon: ThemeIcons.has-play;
        width: 220px;
        height: 52px;
        clicked => { root.play-clicked(); }
    }
    ActionButton {
        label: Texts.refresh;
        icon: ThemeIcons.refresh;
        has-icon: ThemeIcons.has-refresh;
        width: 130px;
        height: 52px;
        clicked => { root.refresh-clicked(); }
    }
    ActionButton {
        label: Texts.mods;
        icon: ThemeIcons.mods;
        has-icon: ThemeIcons.has-mods;
        width: 110px;
        height: 52px;
        clicked => { root.mods-clicked(); }
    }
    Rectangle { horizontal-stretch: 1; }
}

component ZoneItem inherits Rectangle {
    in property <string> item;
    in property <[ProfileItem]> profiles;
    in property <int> selected-index;
    in property <string> user-name;
    in property <string> user-host;
    in property <string> user-initial;
    in property <image> user-avatar;
    in property <bool> has-avatar: false;
    in property <string> countdown-text;
    in property <[NewsItem]> news;
    in property <bool> can-play: false;
    callback profile-clicked(int);
    callback settings-clicked();
    callback logout-clicked();
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();

    height: LayoutState.block-height(item) * 1px;

    if item == "user": UserCard {
        width: 100%;
        height: 100%;
        name: root.user-name;
        host: root.user-host;
        initial: root.user-initial;
        avatar: root.user-avatar;
        has-avatar: root.has-avatar;
    }
    if item == "profiles": ProfileList {
        width: 100%;
        height: 100%;
        profiles: root.profiles;
        selected-index: root.selected-index;
        profile-clicked(id) => { root.profile-clicked(id); }
    }
    if item == "countdown": CountdownCard {
        width: 100%;
        height: 100%;
        text: root.countdown-text;
    }
    if item == "sidebar-actions": SidebarActions {
        width: 100%;
        height: 100%;
        settings-clicked => { root.settings-clicked(); }
        logout-clicked => { root.logout-clicked(); }
    }
    if item == "news": NewsBlock {
        width: 100%;
        height: 100%;
        news: root.news;
    }
    if item == "main-actions": MainActions {
        width: 100%;
        height: 100%;
        can-play: root.can-play;
        play-clicked => { root.play-clicked(); }
        refresh-clicked => { root.refresh-clicked(); }
        mods-clicked => { root.mods-clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: Theme.radius-md;
    background: checked ? Theme.accent : Theme.surface-hover;

    Rectangle {
        width: 20px;
        height: 20px;
        y: 3px;
        x: root.checked ? root.width - 23px : 3px;
        border-radius: Theme.radius-md;
        background: Theme.accent-text;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component AppWindow inherits Window {
    title: Texts.app-title;
    preferred-width: 1180px;
    preferred-height: 640px;
    min-width: 1080px;
    min-height: 620px;
    icon: @image-url("../assets/logo.png");
    background: Theme.background;
    no-frame: true;
    resize-border-width: 6px;
    default-font-family: Theme.font-family;
    // Regular 400 shimmers on the dark background at 14 px; SemiBold reads
    // cleaner without looking like a heading.
    default-font-weight: Theme.base-font-weight;

    // ---- login / global state -------------------------------------------
    in-out property <int> screen: 0;
    in-out property <bool> splash: true;
    in-out property <float> splash-progress: 0;
    in-out property <bool> window-maximized: false;
    in-out property <float> screen-opacity: 1;
    in-out property <string> app-version: "";
    in-out property <string> login: "";
    in-out property <string> password: "";
    in-out property <string> error-text: "";
    in-out property <bool> busy: false;
    in-out property <bool> show-2fa: false;
    in-out property <string> twofa: "";
    in-out property <int> server-index: 0;
    in-out property <string> server-label: "RU-2";
    in-out property <string> server-host-label: "";
    in-out property <string> background-effect: "none";
    in-out property <string> set-background-effect: "none";
    in-out property <[ThemeOption]> themes: [];
    in-out property <string> set-theme: "dark";
    in-out property <string> set-theme-mode: "base";
    in-out property <string> set-accent: "";
    in-out property <string> set-language: "ru";
    in-out property <float> set-glass-opacity: 0.55;
    in-out property <float> set-glass-blur: 0.5;
    in-out property <bool> follow-windows-theme: false;
    in-out property <string> light-theme: "light";
    in-out property <string> dark-theme: "dark";
    in-out property <[string]> layout-sidebar-left: [];
    in-out property <[string]> layout-sidebar-right: [];
    // Main-screen lists exclude hidden blocks entirely, so they do not reserve
    // layout space or spacing. The editor keeps the full lists above.
    in-out property <[string]> layout-sidebar-left-visible: [];
    in-out property <[string]> layout-sidebar-right-visible: [];
    in-out property <[string]> layout-header-visible: [];
    in-out property <[string]> layout-content-top-visible: [];
    in-out property <[string]> layout-content-bottom-visible: [];
    in-out property <[string]> layout-footer-visible: [];
    in-out property <[string]> layout-header: [];
    in-out property <[string]> layout-content-top: [];
    in-out property <[string]> layout-content-bottom: [];
    in-out property <[string]> layout-footer: [];
    in-out property <[string]> layout-hidden: [];
    in-out property <int> layout-sidebar-left-width: 316;
    in-out property <int> layout-sidebar-right-width: 300;
    in-out property <bool> sidebar-actions-left: true;
    in-out property <bool> sidebar-actions-right: false;
    in-out property <bool> sidebar-right-has-visible: false;
    in-out property <[string]> layout-profiles: [];
    in-out property <string> layout-profile: "По умолчанию";
    in-out property <string> layout-profile-name: "";
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-title: "";
    in-out property <string> toast-body: "";
    in-out property <bool> server-menu-open: false;
    in-out property <bool> startup-ready: false;
    in-out property <string> countdown-text: "";
    in-out property <string> main-status: "";

    // ---- main ------------------------------------------------------------
    in-out property <string> user-name: "";
    in-out property <string> user-initial: "?";
    in-out property <image> user-avatar;
    in-out property <bool> has-avatar: false;
    in-out property <[ProfileItem]> profiles: [];
    in-out property <int> selected-index: -1;
    in-out property <string> selected-title: "Профиль не выбран";
    in-out property <string> selected-description: "";
    in-out property <string> selected-version: "";
    in-out property <string> selected-online: "";
    in-out property <image> selected-icon;
    in-out property <[NewsItem]> news: [];
    in-out property <[ModItem]> mods: [];
    in-out property <int> mods-enabled: 0;
    in-out property <int> mods-total: 0;
    in-out property <string> mods-filter: "";
    in-out property <int> mods-missing: 0;
    in-out property <bool> can-play: false;

    in-out property <bool> progress-visible: false;
    in-out property <float> progress-value: 0;
    in-out property <string> progress-title: "";
    in-out property <string> progress-text: "";
    in-out property <string> progress-speed: "";

    in-out property <string> backend-mode: "";
    in-out property <bool> backend-mode-visible: false;
    in-out property <bool> backend-mode-expanded: true;
    in-out property <color> backend-mode-color: Theme.success;

    // ---- settings --------------------------------------------------------
    in-out property <string> set-install-dir: "";
    in-out property <int> set-xms: 2048;
    in-out property <int> set-xmx: 8192;
    in-out property <string> set-width-text: "900";
    in-out property <string> set-height-text: "600";
    in-out property <bool> set-fullscreen: false;
    in-out property <string> set-custom-jvm: "";
    in-out property <string> set-custom-java: "";
    in-out property <bool> set-auto-login: true;

    in-out property <bool> set-send-hwid: true;
    in-out property <bool> set-sounds: true;
    in-out property <bool> set-hide-on-launch: true;
    in-out property <bool> set-discord-rpc: true;
    in-out property <int> max-ram: 16384;
    in-out property <string> settings-status: "";


    callback login-clicked();
    callback verify-clicked();
    callback offline-clicked();
    callback hwid-toggled(bool);
    callback logout-clicked();
    callback settings-clicked();
    callback back-clicked();
    callback play-clicked();
    callback cancel-launch-clicked();
    callback refresh-clicked();
    callback mods-clicked();
    callback mods-refresh-clicked();
    callback mod-toggled(int, bool);
    callback mod-download-clicked(int);
    callback mods-filter-changed(string);
    callback mods-open-folder-clicked();
    callback mods-download-missing-clicked();
    callback mods-set-all-toggled(bool);
    callback server-clicked(int);
    callback profile-clicked(int);
    callback save-settings-clicked();
    callback export-diagnostics-clicked();
    callback check-backend-clicked();
    callback adjust-xms(int);
    callback adjust-xmx(int);
    callback theme-clicked(string);
    callback theme-mode-clicked(string);
    callback refresh-accent-clicked();
    callback pick-accent-clicked();
    callback accent-applied();
    callback follow-windows-toggled(bool);
    callback pair-theme-step(string, bool);
    callback language-clicked(string);
    callback glass-changed();
    callback save-window-geometry();
    callback toast-close();
    callback themes-refresh-clicked();
    callback themes-open-folder-clicked();
    callback open-install-clicked();
    callback open-logs-clicked();
    callback clear-cache-clicked();
    callback check-files-clicked();
    callback pick-java-clicked();
    callback test-sound-clicked();
    callback copy-hwid-clicked();
    callback reset-window-clicked();
    callback theme-reset-clicked();
    callback layout-move(string, string);
    callback layout-drop(string, string, string);
    callback layout-widths-changed(int, int);
    callback layout-profile-save(string);
    callback layout-profile-switch(string);
    callback layout-profile-delete(string);
    callback layout-profile-rename(string, string);
    callback layout-reset-clicked();
    callback maximize-clicked();

    // =====================================================================
    // LOGIN
    // =====================================================================
    if screen == 0: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: Theme.mode == "liquid-glass" ? 0.65 : 0.4;
        }

        Rectangle {
            background: Theme.mode == "liquid-glass"
                ? @linear-gradient(180deg, Theme.gradient-start.with-alpha(0.22) 0%, Theme.background.with-alpha(0.50) 55%, Theme.background.with-alpha(0.72) 100%)
                : @linear-gradient(180deg, Theme.background.with-alpha(0.8) 0%, Theme.background.with-alpha(0.94) 55%, Theme.background 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                width: 440px;
                spacing: 18px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Image {
                        source: @image-url("../assets/logo.svg");
                        width: 44px;
                        height: 44px;
                    }
                    Text {
                        text: "Vestalis";
                        color: Theme.text;
                        font-size: 40px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Femboy Edition";
                        color: Theme.accent-hover;
                        font-size: 14px;
                        vertical-alignment: bottom;
                    }
                }

                Rectangle {
                    height: root.show-2fa ? 590px : 485px;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface.with-alpha(0.95);
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 12px;

                        Text {
                            text: Texts.login-title;
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        Text {
                            text: Texts.login-subtitle;
                            color: Theme.text-muted;
                            font-size: 14px;
                        }

                        Rectangle { height: 4px; }

                        TextField {
                            text <=> root.login;
                            placeholder: Texts.login-username;
                            accepted => { root.login-clicked(); }
                        }
                        TextField {
                            text <=> root.password;
                            placeholder: Texts.login-password;
                            password: true;
                            accepted => { root.login-clicked(); }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Toggle {
                                checked: root.set-send-hwid;
                                toggled(v) => { root.set-send-hwid = v; root.hwid-toggled(v); }
                            }
                            Text {
                                text: Texts.login-hwid;
                                color: Theme.text-muted;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.show-2fa: VerticalLayout {
                            spacing: 8px;
                            TextField {
                                text <=> root.twofa;
                                placeholder: Texts.login-2fa;
                                accepted => { root.verify-clicked(); }
                            }
                            ActionButton {
                                label: root.busy ? Texts.login-checking : Texts.login-2fa-submit;
                                primary: true;
                                available: !root.busy;
                                clicked => { root.verify-clicked(); }
                            }
                        }

                        Text {
                            text: root.error-text;
                            color: Theme.danger;
                            font-size: 14px;
                            wrap: word-wrap;
                            visible: !root.error-text.is-empty;
                        }

                        Rectangle { vertical-stretch: 1; }

                        ActionButton {
                            label: root.busy ? Texts.login-busy : Texts.login-submit;
                            primary: true;
                            available: !root.busy;
                            clicked => { root.login-clicked(); }
                        }
                        ActionButton {
                            label: Texts.login-offline;
                            available: !root.busy;
                            clicked => { root.offline-clicked(); }
                        }
                    }
                }

                Text {
                    text: "v" + root.app-version;
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MAIN
    // =====================================================================
    if screen == 1: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: Theme.mode == "liquid-glass" ? 0.5 : 0.22;
        }
        Rectangle {
            background: Theme.mode == "liquid-glass"
                ? @linear-gradient(120deg, Theme.gradient-start.with-alpha(0.25) 0%, Theme.background.with-alpha(0.52) 55%, Theme.gradient-end.with-alpha(0.28) 100%)
                : @linear-gradient(120deg, Theme.background.with-alpha(0.96) 0%, Theme.background.with-alpha(0.85) 55%, Theme.background.with-alpha(0.95) 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            spacing: 0px;

            // ---- sidebar ----
            Rectangle {
                width: root.layout-sidebar-left-width * 1px;
                background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface-low : Theme.background-alt.with-alpha(0.95));
                border-width: 0px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            source: @image-url("../assets/logo.svg");
                            width: 34px;
                            height: 34px;
                        }
                        Text {
                            text: "Vestalis";
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Texts.app-subtitle;
                            color: Theme.accent-hover;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    // Scrolls independently; sidebar-actions stays pinned below.
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;
                            for item in root.layout-sidebar-left-visible: ZoneItem {
                                item: item;
                                profiles: root.profiles;
                                selected-index: root.selected-index;
                                user-name: root.user-name;
                                user-host: root.server-host-label;
                                user-initial: root.user-initial;
                                user-avatar: root.user-avatar;
                                has-avatar: root.has-avatar;
                                countdown-text: root.countdown-text;
                                news: root.news;
                                can-play: root.can-play;
                                profile-clicked(id) => { root.profile-clicked(id); }
                                settings-clicked => { root.settings-clicked(); }
                                logout-clicked => { root.logout-clicked(); }
                                play-clicked => { root.play-clicked(); }
                                refresh-clicked => { root.refresh-clicked(); }
                                mods-clicked => { root.mods-clicked(); }
                            }
                        }
                    }

                    if root.sidebar-actions-left && !LayoutState.is-hidden("sidebar-actions"): ZoneItem {
                        item: "sidebar-actions";
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                    }
                }
            }

            // ---- content ----
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 28px;
                spacing: 12px;

                for item in root.layout-header-visible: ZoneItem {
                    item: item;
                    profiles: root.profiles;
                    selected-index: root.selected-index;
                    user-name: root.user-name;
                    user-host: root.server-host-label;
                    user-initial: root.user-initial;
                    user-avatar: root.user-avatar;
                    has-avatar: root.has-avatar;
                    countdown-text: root.countdown-text;
                    news: root.news;
                    can-play: root.can-play;
                    profile-clicked(id) => { root.profile-clicked(id); }
                    settings-clicked => { root.settings-clicked(); }
                    logout-clicked => { root.logout-clicked(); }
                    play-clicked => { root.play-clicked(); }
                    refresh-clicked => { root.refresh-clicked(); }
                    mods-clicked => { root.mods-clicked(); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 26px;
                        width: version-text.preferred-width + 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        visible: !root.selected-version.is-empty;
                        version-text := Text {
                            text: root.selected-version;
                            color: Theme.text-muted;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        width: online-text.preferred-width + 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.success.with-alpha(0.12);
                        border-width: 1px;
                        border-color: Theme.success.with-alpha(0.25);
                        visible: !root.selected-online.is-empty;
                        online-text := Text {
                            text: root.selected-online;
                            color: Theme.success;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: root.backend-mode-expanded ? 26px : 16px;
                        width: root.backend-mode-expanded ? mode-text.preferred-width + 28px : 16px;
                        border-radius: root.backend-mode-expanded ? Theme.radius-md : Theme.radius-sm;
                        background: root.backend-mode-color;
                        visible: root.backend-mode-visible;
                        animate height { duration: 220ms; easing: ease-out; }
                        animate background { duration: 220ms; }

                        mode-text := Text {
                            text: root.backend-mode;
                            color: Theme.accent-text;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: root.backend-mode-expanded;
                            opacity: root.backend-mode-expanded ? 1 : 0;
                        }
                    }
                }

                Text {
                    text: root.selected-title;
                    color: Theme.text;
                    font-size: 40px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.selected-description;
                    color: Theme.text-muted;
                    font-size: 14px;
                    wrap: word-wrap;
                    max-height: 58px;
                    overflow: elide;
                }

                Rectangle { height: 8px; }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    for item in root.layout-content-top-visible: ZoneItem {
                        item: item;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                    }
                }

                if root.progress-visible: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.progress-title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.progress-speed;
                            color: Theme.accent-hover;
                            font-size: 14px;
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: Theme.radius-xs;
                        background: Theme.border;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.progress-value;
                            height: 100%;
                            border-radius: Theme.radius-xs;
                            background: @linear-gradient(90deg, Theme.gradient-start 0%, Theme.accent-hover 100%);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.progress-text;
                            color: Theme.text-muted;
                            font-size: 14px;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        ActionButton {
                            label: Texts.cancel;
                            width: 110px;
                            height: 30px;
                            clicked => { root.cancel-launch-clicked(); }
                        }
                    }
                }

                if !root.main-status.is-empty: Text {
                    text: root.main-status;
                    color: Theme.success;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                if !root.error-text.is-empty: Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle { height: 2px; }

                for item in root.layout-content-bottom-visible: ZoneItem {
                    item: item;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                }
                for item in root.layout-footer-visible: ZoneItem {
                    item: item;
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        profile-clicked(id) => { root.profile-clicked(id); }
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                        play-clicked => { root.play-clicked(); }
                        refresh-clicked => { root.refresh-clicked(); }
                        mods-clicked => { root.mods-clicked(); }
                }
            }

            if root.sidebar-right-has-visible: Rectangle {
                width: root.layout-sidebar-right-width * 1px;
                background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface-low : Theme.background-alt.with-alpha(0.95));
                border-width: 0px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;
                            for item in root.layout-sidebar-right-visible: ZoneItem {
                                item: item;
                                profiles: root.profiles;
                                selected-index: root.selected-index;
                                user-name: root.user-name;
                                user-host: root.server-host-label;
                                user-initial: root.user-initial;
                                user-avatar: root.user-avatar;
                                has-avatar: root.has-avatar;
                                countdown-text: root.countdown-text;
                                news: root.news;
                                can-play: root.can-play;
                                profile-clicked(id) => { root.profile-clicked(id); }
                                settings-clicked => { root.settings-clicked(); }
                                logout-clicked => { root.logout-clicked(); }
                                play-clicked => { root.play-clicked(); }
                                refresh-clicked => { root.refresh-clicked(); }
                                mods-clicked => { root.mods-clicked(); }
                            }
                        }
                    }

                    if root.sidebar-actions-right && !LayoutState.is-hidden("sidebar-actions"): ZoneItem {
                        item: "sidebar-actions";
                        profiles: root.profiles;
                        selected-index: root.selected-index;
                        user-name: root.user-name;
                        user-host: root.server-host-label;
                        user-initial: root.user-initial;
                        user-avatar: root.user-avatar;
                        has-avatar: root.has-avatar;
                        countdown-text: root.countdown-text;
                        news: root.news;
                        can-play: root.can-play;
                        settings-clicked => { root.settings-clicked(); }
                        logout-clicked => { root.logout-clicked(); }
                    }
                }
            }
        }
    }

    // =====================================================================
    // SETTINGS
    // =====================================================================
    Rectangle {
        visible: screen == 2;
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        background: Theme.background;

        if Theme.mode == "liquid-glass": GlassBackdrop {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: Texts.back;
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: Texts.settings-title;
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.settings-status;
                    color: Theme.success;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    // ---- column 1 ----
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: ram-layout.preferred-height + 40px;

                            ram-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: Texts.memory-title; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: Texts.memory-desc + root.max-ram + " MB";
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.memory-xms; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xms(-512); } }
                                    Text {
                                        text: root.set-xms + " МБ";
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xms(512); } }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.memory-xmx; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xmx(-1024); } }
                                    Text {
                                        text: root.set-xmx + " МБ";
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xmx(1024); } }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: jvm-layout.preferred-height + 40px;

                            jvm-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: Texts.jvm-title; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: Texts.jvm-desc;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                TextField {
                                    text <=> root.set-custom-jvm;
                                    placeholder: "-XX:+UseZGC -XX:+UnlockExperimentalVMOptions";
                                }
                            }
                        }
                    }

                    // ---- column 2 ----
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: window-layout.preferred-height + 40px;

                            window-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: Texts.game-title; color: Theme.text; font-size: 17px; font-weight: 700; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.game-fullscreen; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-fullscreen;
                                        toggled(v) => { root.set-fullscreen = v; }
                                    }
                                }

                                if !root.set-fullscreen: HorizontalLayout {
                                    spacing: 10px;
                                    TextField { text <=> root.set-width-text; numeric: true; horizontal-stretch: 1; }
                                    Text { text: "×"; color: Theme.text-muted; vertical-alignment: center; }
                                    TextField { text <=> root.set-height-text; numeric: true; horizontal-stretch: 1; }
                                }

                                Text { text: Texts.game-java; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    TextField {
                                        text <=> root.set-custom-java;
                                        placeholder: "C:\\Program Files\\Java\\bin\\javaw.exe";
                                        horizontal-stretch: 1;
                                    }
                                    ActionButton {
                                        label: "Обзор…";
                                        width: 110px;
                                        height: 38px;
                                        clicked => { root.pick-java-clicked(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: Texts.interface-hide;
                                        color: Theme.text-muted;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Toggle {
                                        checked: root.set-hide-on-launch;
                                        toggled(v) => { root.set-hide-on-launch = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: launcher-layout.preferred-height + 40px;

                            launcher-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Лаунчер"; color: Theme.text; font-size: 17px; font-weight: 700; }

                                Text { text: "Папка установки"; color: Theme.text-muted; font-size: 14px; }
                                TextField {
                                    text <=> root.set-install-dir;
                                    placeholder: "%APPDATA%\\Vestalis";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: Texts.utility-install;
                                        width: 185px;
                                        height: 34px;
                                        icon: ThemeIcons.folder;
                                        has-icon: ThemeIcons.has-folder;
                                        clicked => { root.open-install-clicked(); }
                                    }
                                    ActionButton {
                                        label: Texts.utility-logs;
                                        width: 90px;
                                        height: 34px;
                                        clicked => { root.open-logs-clicked(); }
                                    }
                                    ActionButton {
                                        label: Texts.utility-reset-window;
                                        width: 155px;
                                        height: 34px;
                                        clicked => { root.reset-window-clicked(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: Texts.utility-check-files;
                                        width: 160px;
                                        height: 34px;
                                        clicked => { root.check-files-clicked(); }
                                    }
                                    ActionButton {
                                        label: Texts.utility-clear-cache;
                                        width: 150px;
                                        height: 34px;
                                        clicked => { root.clear-cache-clicked(); }
                                    }
                                }

                                Text { text: Texts.interface-background; color: Theme.text-muted; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Нет";
                                        primary: root.set-background-effect == "none";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "none"; root.background-effect = "none"; }
                                    }
                                    ActionButton {
                                        label: "Светлячки";
                                        primary: root.set-background-effect == "fireflies";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "fireflies"; root.background-effect = "fireflies"; }
                                    }
                                    ActionButton {
                                        label: "Листья";
                                        primary: root.set-background-effect == "leaves";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "leaves"; root.background-effect = "leaves"; }
                                    }
                                    ActionButton {
                                        label: "Снежинки";
                                        primary: root.set-background-effect == "snow";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "snow"; root.background-effect = "snow"; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.interface-hwid; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton {
                                        label: Texts.interface-copy-hwid;
                                        width: 165px;
                                        height: 30px;
                                        clicked => { root.copy-hwid-clicked(); }
                                    }
                                    Toggle {
                                        checked: root.set-send-hwid;
                                        toggled(v) => { root.set-send-hwid = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.interface-sounds; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton {
                                        label: Texts.interface-test-sound;
                                        width: 145px;
                                        height: 30px;
                                        clicked => { root.test-sound-clicked(); }
                                    }
                                    Toggle {
                                        checked: root.set-sounds;
                                        toggled(v) => { root.set-sounds = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.interface-discord; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-discord-rpc;
                                        toggled(v) => { root.set-discord-rpc = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: Texts.interface-auto-login; color: Theme.text-muted; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-auto-login;
                                        toggled(v) => { root.set-auto-login = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: theme-layout.preferred-height + 40px;

                            theme-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: Texts.appearance-title; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: Texts.appearance-desc;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                Text { text: Texts.appearance-mode; color: Theme.text-muted; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Base";
                                        primary: root.set-theme-mode == "base";
                                        width: 110px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "base"; root.theme-mode-clicked("base"); }
                                    }
                                    ActionButton {
                                        label: "Material 3";
                                        primary: root.set-theme-mode == "material3";
                                        width: 140px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "material3"; root.theme-mode-clicked("material3"); }
                                    }
                                    ActionButton {
                                        label: "Liquid Glass";
                                        primary: root.set-theme-mode == "liquid-glass";
                                        width: 150px;
                                        height: 36px;
                                        clicked => { root.set-theme-mode = "liquid-glass"; root.theme-mode-clicked("liquid-glass"); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: Texts.appearance-accent-hint;
                                        color: Theme.text-muted;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    ActionButton {
                                        label: Texts.appearance-windows;
                                        width: 190px;
                                        height: 36px;
                                        clicked => { root.refresh-accent-clicked(); }
                                    }
                                }

                                Text { text: Texts.appearance-manual; color: Theme.text-muted; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    TextField {
                                        text <=> root.set-accent;
                                        placeholder: "#RRGGBB";
                                        width: 180px;
                                        height: 40px;
                                        accepted => { root.accent-applied(); }
                                    }
                                    ActionButton {
                                        label: Texts.apply;
                                        width: 120px;
                                        height: 40px;
                                        clicked => { root.accent-applied(); }
                                    }
                                    ActionButton {
                                        label: Texts.pick;
                                        width: 120px;
                                        height: 40px;
                                        clicked => { root.pick-accent-clicked(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Toggle {
                                        checked: root.follow-windows-theme;
                                        toggled(v) => {
                                            root.follow-windows-theme = v;
                                            root.follow-windows-toggled(v);
                                        }
                                    }
                                    Text {
                                        text: Texts.appearance-follow;
                                        color: Theme.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.follow-windows-theme: VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: Texts.appearance-light; color: Theme.text-muted; font-size: 14px; width: 110px; vertical-alignment: center; }
                                        ActionButton { label: "‹"; width: 40px; height: 34px; clicked => { root.pair-theme-step("light", false); } }
                                        Text { text: root.light-theme; color: Theme.text; font-size: 14px; width: 140px; vertical-alignment: center; horizontal-alignment: center; }
                                        ActionButton { label: "›"; width: 40px; height: 34px; clicked => { root.pair-theme-step("light", true); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: Texts.appearance-dark; color: Theme.text-muted; font-size: 14px; width: 110px; vertical-alignment: center; }
                                        ActionButton { label: "‹"; width: 40px; height: 34px; clicked => { root.pair-theme-step("dark", false); } }
                                        Text { text: root.dark-theme; color: Theme.text; font-size: 14px; width: 140px; vertical-alignment: center; horizontal-alignment: center; }
                                        ActionButton { label: "›"; width: 40px; height: 34px; clicked => { root.pair-theme-step("dark", true); } }
                                    }
                                }

                                for t in root.themes: Rectangle {
                                    height: 46px;
                                    border-radius: Theme.radius-md;
                                    background: root.set-theme == t.name
                                        ? (Theme.mode == "material3"
                                            ? Theme.primary-container
                                            : Theme.accent.with-alpha(0.16))
                                        : Theme.surface-hover;
                                    border-width: 1px;
                                    border-color: root.set-theme == t.name ? Theme.accent : Theme.border;

                                    HorizontalLayout {
                                        width: parent.width;
                                        padding: 10px;
                                        spacing: 10px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.accent;
                                        }
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.surface;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                        }
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: Theme.radius-pill;
                                            background: t.text;
                                        }

                                        Text {
                                            text: t.name;
                                            color: root.set-theme == t.name && Theme.mode == "material3"
                                                ? Theme.on-primary-container
                                                : Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: t.builtin ? Texts.appearance-builtin : Texts.appearance-custom;
                                            color: Theme.text-muted;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.set-theme = t.name;
                                            root.theme-clicked(t.name);
                                        }
                                    }
                                }

                                Text { text: "Liquid Glass: прозрачность и имитация размытия"; color: Theme.text; font-size: 14px; font-weight: 600; }
                                Text {
                                    text: "В Slint 1.18 нет настоящего backdrop-blur: глубина имитируется слоями и градиентными бликами.";
                                    color: Theme.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Прозрачность"; color: Theme.text-muted; font-size: 14px; width: 120px; vertical-alignment: center; }
                                    Slider {
                                        minimum: 0.25;
                                        maximum: 0.9;
                                        value <=> root.set-glass-opacity;
                                        changed(v) => { root.set-glass-opacity = v; root.glass-changed(); }
                                        horizontal-stretch: 1;
                                    }
                                    Text { text: "\{Math.round(root.set-glass-opacity * 100)}%"; color: Theme.text; font-size: 14px; width: 60px; horizontal-alignment: end; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Сила имитации"; color: Theme.text-muted; font-size: 14px; width: 120px; vertical-alignment: center; }
                                    Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value <=> root.set-glass-blur;
                                        changed(v) => { root.set-glass-blur = v; root.glass-changed(); }
                                        horizontal-stretch: 1;
                                    }
                                    Text { text: "\{Math.round(root.set-glass-blur * 100)}%"; color: Theme.text; font-size: 14px; width: 60px; horizontal-alignment: end; vertical-alignment: center; }
                                }

                                Text { text: Texts.language-title; color: Theme.text; font-size: 14px; font-weight: 600; }
                                Text { text: Texts.language-hint; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Русский";
                                        primary: root.set-language == "ru";
                                        width: 120px;
                                        height: 34px;
                                        clicked => { root.set-language = "ru"; root.language-clicked("ru"); }
                                    }
                                    ActionButton {
                                        label: "English";
                                        primary: root.set-language == "en";
                                        width: 120px;
                                        height: 34px;
                                        clicked => { root.set-language = "en"; root.language-clicked("en"); }
                                    }
                                    ActionButton {
                                        label: "Українська";
                                        primary: root.set-language == "ua";
                                        width: 130px;
                                        height: 34px;
                                        clicked => { root.set-language = "ua"; root.language-clicked("ua"); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: Texts.appearance-refresh;
                                        width: 150px;
                                        height: 38px;
                                        clicked => { root.themes-refresh-clicked(); }
                                    }
                                    ActionButton {
                                        label: Texts.appearance-open;
                                        width: 175px;
                                        height: 38px;
                                        icon: ThemeIcons.folder;
                                        has-icon: ThemeIcons.has-folder;
                                        clicked => { root.themes-open-folder-clicked(); }
                                    }
                                    ActionButton {
                                        label: Texts.appearance-reset;
                                        width: 150px;
                                        height: 38px;
                                        clicked => {
                                            root.set-theme = "dark";
                                            root.theme-reset-clicked();
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.mode == "liquid-glass"
                                ? @linear-gradient(160deg, Theme.glass-highlight 0%, Theme.glass-tint 30%, Theme.glass-tint 100%)
                                : (Theme.mode == "material3" ? Theme.surface : Theme.surface.with-alpha(Theme.card-opacity));
                            border-width: 1px;
                            border-color: Theme.mode == "liquid-glass" ? Theme.glass-border : (Theme.mode == "material3" ? Theme.outline : Theme.border);
                            drop-shadow-blur: Theme.mode == "material3" ? 16px : (Theme.mode == "liquid-glass" ? 28px : 0px);
                            drop-shadow-offset-y: Theme.mode == "material3" ? 4px : (Theme.mode == "liquid-glass" ? 10px : 0px);
                            drop-shadow-color: Theme.shadow;
                            
                            Rectangle {
                                x: 12px;
                                y: 0;
                                width: parent.width - 24px;
                                height: 1px;
                                border-radius: Theme.radius-pill;
                                background: Theme.glass-highlight;
                                visible: Theme.mode == "liquid-glass";
                            }
                            height: layout-card.preferred-height + 40px;

                            layout-card := VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Text { text: Texts.layout-title; color: Theme.text; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: Texts.layout-desc;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-left;
                                    zone: "sidebar-left";
                                    items: root.layout-sidebar-left;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-right;
                                    zone: "sidebar-right";
                                    items: root.layout-sidebar-right;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-header;
                                    zone: "header";
                                    items: root.layout-header;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-content-top;
                                    zone: "content-top";
                                    items: root.layout-content-top;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-content-bottom;
                                    zone: "content-bottom";
                                    items: root.layout-content-bottom;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }
                                LayoutZone {
                                    title: Texts.layout-zone-footer;
                                    zone: "footer";
                                    items: root.layout-footer;
                                    move(i, direction) => { root.layout-move(i, direction); }
                                    drop(item, zone, before) => { root.layout-drop(item, zone, before); }
                                }

                                Text { text: Texts.layout-widths; color: Theme.text; font-size: 14px; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: Texts.layout-width-left + ": \{root.layout-sidebar-left-width} px"; color: Theme.text-muted; font-size: 14px; width: 130px; vertical-alignment: center; }
                                    MiniButton { label: "−"; clicked => { root.layout-widths-changed(root.layout-sidebar-left-width - 20, root.layout-sidebar-right-width); } }
                                    MiniButton { label: "+"; clicked => { root.layout-widths-changed(root.layout-sidebar-left-width + 20, root.layout-sidebar-right-width); } }
                                    Text { text: Texts.layout-width-right + ": \{root.layout-sidebar-right-width} px"; color: Theme.text-muted; font-size: 14px; width: 140px; vertical-alignment: center; }
                                    MiniButton { label: "−"; clicked => { root.layout-widths-changed(root.layout-sidebar-left-width, root.layout-sidebar-right-width - 20); } }
                                    MiniButton { label: "+"; clicked => { root.layout-widths-changed(root.layout-sidebar-left-width, root.layout-sidebar-right-width + 20); } }
                                }

                                Text { text: Texts.layout-profiles; color: Theme.text; font-size: 14px; font-weight: 600; }
                                Text {
                                    text: Texts.layout-active + ": \{root.layout-profile}";
                                    color: Theme.text-muted;
                                    font-size: 13px;
                                }
                                for profile in root.layout-profiles: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: profile;
                                        color: profile == root.layout-profile ? Theme.text : Theme.text-muted;
                                        font-weight: profile == root.layout-profile ? 700 : 500;
                                        font-size: 14px;
                                        width: 160px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    ActionButton {
                                        label: Texts.load;
                                        width: 110px;
                                        height: 32px;
                                        available: profile != root.layout-profile;
                                        clicked => { root.layout-profile-switch(profile); }
                                    }
                                    ActionButton {
                                        label: Texts.delete;
                                        width: 100px;
                                        height: 32px;
                                        clicked => { root.layout-profile-delete(profile); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    TextField {
                                        text <=> root.layout-profile-name;
                                        placeholder: Texts.layout-name-placeholder;
                                        width: 230px;
                                        height: 38px;
                                    }
                                    ActionButton {
                                        label: Texts.layout-save-profile;
                                        width: 180px;
                                        height: 38px;
                                        clicked => { root.layout-profile-save(root.layout-profile-name); }
                                    }
                                    ActionButton {
                                        label: Texts.rename;
                                        width: 160px;
                                        height: 38px;
                                        clicked => { root.layout-profile-rename(root.layout-profile, root.layout-profile-name); }
                                    }
                                }

                                ActionButton {
                                    label: Texts.layout-reset;
                                    width: 190px;
                                    height: 38px;
                                    clicked => { root.layout-reset-clicked(); }
                                }
                            }
                        }

                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: "Сохранить настройки";
                    primary: true;
                    width: 240px;
                    height: 48px;
                    clicked => { root.save-settings-clicked(); }
                }
                ActionButton {
                    label: "Экспорт диагностики";
                    width: 220px;
                    height: 48px;
                    clicked => { root.export-diagnostics-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "v" + root.app-version;
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MODS
    // =====================================================================
    if screen == 3: Rectangle {
        width: 100%;
        y: 42px;
        height: root.height - 42px;
        opacity: root.screen-opacity;
        background: Theme.background;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: Texts.back;
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: Texts.mods-title;
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.mods-enabled + " / " + root.mods-total + " " + Texts.mods-count;
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 10px;
                TextField {
                    text <=> root.mods-filter;
                    placeholder: Texts.mods-search;
                    height: 38px;
                    horizontal-stretch: 1;
                    edited(value) => { root.mods-filter-changed(value); }
                }
                if root.mods-missing > 0: ActionButton {
                    label: Texts.mods-download-missing + " (\{root.mods-missing})";
                    width: 240px;
                    height: 38px;
                    primary: true;
                    clicked => { root.mods-download-missing-clicked(); }
                }
                ActionButton {
                    label: Texts.mods-folder;
                    width: 150px;
                    height: 38px;
                    icon: ThemeIcons.folder;
                    has-icon: ThemeIcons.has-folder;
                    clicked => { root.mods-open-folder-clicked(); }
                }
                ActionButton {
                    label: Texts.mods-refresh;
                    width: 130px;
                    height: 38px;
                    clicked => { root.mods-refresh-clicked(); }
                }
            }

            Text {
                text: Texts.mods-desc;
                color: Theme.text-muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                ActionButton {
                    label: Texts.mods-enable-all;
                    width: 150px;
                    height: 34px;
                    clicked => { root.mods-set-all-toggled(true); }
                }
                ActionButton {
                    label: Texts.mods-disable-all;
                    width: 150px;
                    height: 34px;
                    clicked => { root.mods-set-all-toggled(false); }
                }
            }

            if root.mods-total == 0: Text {
                text: Texts.mods-empty;
                color: Theme.text-muted;
                font-size: 14px;
            }
            if root.mods.length == 0 && root.mods-total > 0: Text {
                text: Texts.mods-not-found;
                color: Theme.text-muted;
                font-size: 14px;
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for m in root.mods: Rectangle {
                        height: mod-row.preferred-height + 18px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface.with-alpha(Theme.card-opacity);
                        border-width: 1px;
                        border-color: m.enabled ? Theme.accent.with-alpha(0.25) : Theme.surface-hover;

                        mod-row := HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: m.description;
                                    color: Theme.text-muted;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    visible: !m.description.is-empty;
                                }
                            }

                            if m.downloaded: Toggle {
                                checked: m.enabled;
                                toggled(v) => { root.mod-toggled(m.id, v); }
                            }

                            if !m.downloaded: ActionButton {
                                label: m.downloading ? Texts.downloading : Texts.download;
                                width: 130px;
                                height: 36px;
                                primary: true;
                                icon: ThemeIcons.download;
                                has-icon: ThemeIcons.has-download;
                                available: !m.downloading;
                                clicked => { root.mod-download-clicked(m.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    // In-app toast for news and profile updates. No external notification
    // service and no network round-trip.
    if root.toast-visible: Rectangle {
        x: parent.width - 380px;
        y: 64px;
        width: 360px;
        height: toast-layout.preferred-height + 28px;
        border-radius: Theme.radius-lg;
        background: Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.surface;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.45);
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shadow;
        animate y { duration: 180ms; easing: ease-out; }

        toast-layout := VerticalLayout {
            padding: 14px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.toast-title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: toast-close-area.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        text: "×";
                        color: Theme.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    toast-close-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toast-visible = false; root.toast-close(); }
                    }
                }
            }
            Text {
                text: root.toast-body;
                color: Theme.text-muted;
                font-size: 13px;
                wrap: word-wrap;
                visible: !root.toast-body.is-empty;
            }
        }
    }

    // Branded start screen. The real window is already behind it, so the
    // hand-over is instant once the first backend requests are in flight.
    if root.splash: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.18;
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;

            Rectangle { height: 90px; }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                Image {
                    source: @image-url("../assets/logo.svg");
                    width: 64px;
                    height: 64px;
                }
                Text {
                    text: "Vestalis";
                    color: Theme.text;
                    font-size: 56px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Femboy Edition";
                color: Theme.accent-hover;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Rectangle { height: 18px; }
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 260px;
                    height: 4px;
                    border-radius: Theme.radius-xs;
                    background: Theme.border;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.splash-progress;
                        height: 100%;
                        border-radius: Theme.radius-xs;
                        background: @linear-gradient(90deg, Theme.gradient-end 0%, Theme.accent-hover 50%, Theme.gradient-end 100%);
                    }
                }
            }
            Text {
                text: "Загрузка…";
                color: Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    // Custom title bar (the window uses no-frame).
    Rectangle {
        y: 0;
        width: 100%;
        height: 42px;
        background: Theme.mode == "liquid-glass" ? Theme.glass-tint : (Theme.mode == "material3" ? Theme.surface : Theme.background-alt.with-alpha(0.96));
        border-width: 0px;

        WindowMoveArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
                text: Texts.app-title;
                color: Theme.text-muted;
                font-size: 14px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 138px;
                height: 30px;
                border-radius: Theme.radius-pill;
                background: root.server-menu-open
                    ? Theme.surface-hover
                    : Theme.surface.with-alpha(0.85);
                border-width: 1px;
                border-color: root.server-menu-open ? Theme.accent : Theme.border;
                animate border-color { duration: 130ms; }

                if ThemeIcons.has-server: Image {
                    x: 10px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    source: ThemeIcons.server;
                    image-fit: contain;
                }

                if !ThemeIcons.has-server: Rectangle {
                    x: 10px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: @linear-gradient(135deg, Theme.gradient-start 0%, Theme.gradient-end 100%);

                    Rectangle {
                        x: 4px;
                        y: 5px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.9;
                    }
                    Rectangle {
                        x: 4px;
                        y: 8.25px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.7;
                    }
                    Rectangle {
                        x: 4px;
                        y: 11.5px;
                        width: 10px;
                        height: 1.5px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-text;
                        opacity: 0.5;
                    }
                }

                Text {
                    x: 35px;
                    text: root.server-label;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if ThemeIcons.has-chevron: Image {
                    x: parent.width - 24px;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    source: ThemeIcons.chevron;
                    image-fit: contain;
                }

                if !ThemeIcons.has-chevron: Path {
                    x: parent.width - 22px;
                    y: (parent.height - 6px) / 2;
                    width: 9px;
                    height: 6px;
                    commands: "M 0 0 L 4.5 6 L 9 0";
                    stroke: root.server-menu-open ? Theme.accent : Theme.text-muted;
                    stroke-width: 1.5px;
                    fill: transparent;
                    transform-rotation: root.server-menu-open ? 180deg : 0deg;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.server-menu-open = !root.server-menu-open; }
                }
            }

            CaptionButton {
                kind: "min";
                icon: ThemeIcons.minimize;
                has-icon: ThemeIcons.has-minimize;
                clicked => { root.minimized = true; }
            }
            CaptionButton {
                kind: root.window-maximized ? "restore" : "max";
                icon: root.window-maximized ? ThemeIcons.restore : ThemeIcons.maximize;
                has-icon: root.window-maximized ? ThemeIcons.has-restore : ThemeIcons.has-maximize;
                clicked => { root.maximize-clicked(); }
            }
            CaptionButton {
                kind: "close";
                icon: ThemeIcons.close;
                has-icon: ThemeIcons.has-close;
                clicked => { root.save-window-geometry(); root.close(); }
            }
        }
    }

    if root.server-menu-open: Rectangle {
        y: 42px;
        width: 100%;
        height: root.height - 42px;
        background: transparent;

        TouchArea {
            clicked => { root.server-menu-open = false; }
        }
    }

    if root.server-menu-open: Rectangle {
        x: root.width - 276px;
        y: 46px;
        width: 172px;
        height: 160px;
        border-radius: Theme.radius-lg;
        background: Theme.mode == "liquid-glass" ? Theme.glass-tint : Theme.surface.with-alpha(0.97);
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.shadow;
        
        Rectangle {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            height: 1px;
            border-radius: Theme.radius-pill;
            background: Theme.glass-highlight;
            visible: Theme.mode == "liquid-glass";
        }

        VerticalLayout {
            padding: 5px;
            spacing: 2px;
            ServerMenuItem {
                label: "RU-1";
                active: root.server-index == 0;
                clicked => { root.server-menu-open = false; root.server-clicked(0); }
            }
            ServerMenuItem {
                label: "RU-2";
                active: root.server-index == 1;
                clicked => { root.server-menu-open = false; root.server-clicked(1); }
            }
            ServerMenuItem {
                label: "EU-1";
                active: root.server-index == 2;
                clicked => { root.server-menu-open = false; root.server-clicked(2); }
            }
            ServerMenuItem {
                label: "PL-1";
                disabled: true;
                badge: "W.I.P";
            }
        }
    }
}
