import { ScrollView } from "std-widgets.slint";

// Rounded UI font with Cyrillic coverage (Nunito, OFL).
import "../assets/fonts/Nunito-Regular.ttf";
import "../assets/fonts/Nunito-SemiBold.ttf";
import "../assets/fonts/Nunito-Bold.ttf";


export struct ProfileItem {
    id: int,
    name: string,
    display-name: string,
    initial: string,
    subtitle: string,
    description: string,
    online: int,
    icon: image,
    has-icon: bool,
}

export struct NewsItem {
    title: string,
    body: string,
    date: string,
}

export struct ModItem {
    id: int,
    name: string,
    description: string,
    enabled: bool,
}

export struct SelfTestItem {
    name: string,
    status: string,
    message: string,
    duration: string,
}

// Ambient background effects, driven by Slint's animation clock so they do not
// need a Rust timer. Only the selected variant is instantiated.
component BackgroundEffect inherits Rectangle {
    in property <string> kind: "none";

    if kind == "fireflies": Rectangle {
        for i in 16: Rectangle {
            width: 3px + Math.mod(i, 3) * 1px;
            height: self.width;
            border-radius: 99px;
            background: #fef3c7;
            drop-shadow-blur: 10px;
            drop-shadow-color: #f59e0bcc;
            opacity: 0.2 + 0.75 * abs(sin((animation-tick() / 1s * (18 + Math.mod(i, 6)) + i * 61) * 1deg));
            x: parent.width * (0.04 + Math.mod(i * 37 + 13, 90) / 100.0)
                + 24px * sin((animation-tick() / 1s * (7 + Math.mod(i, 5)) + i * 29) * 1deg);
            y: parent.height * (0.1 + Math.mod(i * 29 + 7, 78) / 100.0)
                + 18px * sin((animation-tick() / 1s * (10 + Math.mod(i, 4)) + i * 47) * 1deg);
        }
    }

    if kind == "leaves": Rectangle {
        for i in 18: Rectangle {
            width: 10px + Math.mod(i, 4) * 3px;
            height: self.width * 0.62;
            border-radius: 99px;
            background: Math.mod(i, 4) == 0 ? #f59e0b
                : Math.mod(i, 4) == 1 ? #d97706
                : Math.mod(i, 4) == 2 ? #84cc16
                : #b45309;
            opacity: 0.55 + 0.35 * abs(sin((animation-tick() / 1s * (9 + Math.mod(i, 5)) + i * 23) * 1deg));
            transform-rotation: sin((animation-tick() / 1s * (24 + Math.mod(i, 5)) + i * 33) * 1deg) * 40deg + i * 17deg;
            x: parent.width * (0.02 + Math.mod(i * 41 + 7, 94) / 100.0)
                + (34px + Math.mod(i, 4) * 8px)
                    * sin((animation-tick() / 1s * (23 + Math.mod(i, 3) * 14) + i * 37) * 1deg);
            y: -28px + (parent.height + 56px)
                * Math.mod(animation-tick() + i * 1400ms, (9 + Math.mod(i, 7)) * 1s)
                / ((9 + Math.mod(i, 7)) * 1s);
        }
    }

    if kind == "snow": Rectangle {
        for i in 28: Rectangle {
            width: 2px + Math.mod(i, 4) * 1.2px;
            height: self.width;
            border-radius: 99px;
            background: #f8fafc;
            opacity: 0.35 + 0.55 * abs(sin((animation-tick() / 1s * (10 + Math.mod(i, 7)) + i * 41) * 1deg));
            x: parent.width * (0.01 + Math.mod(i * 43 + 11, 97) / 100.0)
                + (16px + Math.mod(i, 5) * 7px)
                    * sin((animation-tick() / 1s * (18 + Math.mod(i, 4) * 11) + i * 53) * 1deg);
            y: -12px + (parent.height + 24px)
                * Math.mod(animation-tick() + i * 900ms, (7 + Math.mod(i, 8)) * 1s)
                / ((7 + Math.mod(i, 8)) * 1s);
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();

    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: !available ? #26262c : (primary ? #e879f9 : #303038);
    background: !available ? #17171c
        : area.has-hover ? (primary ? #d946ef : #23232b)
        : (primary ? #a21caf : #1a1a20);
    animate background { duration: 130ms; easing: ease-out; }

    area := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.available ? (root.primary ? #ffffff : #d9d9e2) : #5a5a66;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> numeric: false;
    callback accepted();

    height: 46px;
    border-radius: 10px;
    background: #101014;
    border-width: 1px;
    border-color: input.has-focus ? #a21caf : #26262e;

    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        color: #f2f2f6;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : (root.numeric ? InputType.number : InputType.text);
        selection-background-color: #a21caf;
        accepted => { root.accepted(); }

        // Slint's built-in shortcut lookup can miss Ctrl+V on a non-English
        // layout; accept both the Latin and Cyrillic V keys.
        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М") {
                self.paste();
                return accept;
            }
            return reject;
        }
    }

    if input.text.is-empty && !root.placeholder.is-empty: Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: #60606c;
        font-size: 14px;
        vertical-alignment: center;
    }
}

component CaptionButton inherits Rectangle {
    in property <string> label;
    in property <bool> close: false;
    callback clicked();

    width: 34px;
    height: 26px;
    border-radius: 6px;
    background: area.has-hover ? (close ? #c42b1c : #23232b) : transparent;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: area.has-hover ? #ffffff : #9a9aa6;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ServerMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 7px;
    background: active ? #3b0d42 : (area.has-hover ? #1f1f27 : transparent);

    Text {
        x: 10px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.label;
        color: root.active ? #f5d0fe : #d0d0da;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? #a21caf : #2b2b33;

    Rectangle {
        width: 20px;
        height: 20px;
        y: 3px;
        x: root.checked ? root.width - 23px : 3px;
        border-radius: 10px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component AppWindow inherits Window {
    title: "Vestalis Launcher";
    preferred-width: 1180px;
    preferred-height: 640px;
    icon: @image-url("../assets/logo.png");
    background: #0d0d10;
    no-frame: true;
    resize-border-width: 6px;
    default-font-family: "Nunito";
    // Regular 400 shimmers on the dark background at 14 px; SemiBold reads
    // cleaner without looking like a heading.
    default-font-weight: 600;

    // ---- login / global state -------------------------------------------
    in-out property <int> screen: 0;
    in-out property <bool> splash: true;
    in-out property <float> splash-progress: 0;
    in-out property <bool> window-maximized: false;
    in-out property <float> screen-opacity: 1;
    in-out property <string> app-version: "";
    in-out property <string> login: "";
    in-out property <string> password: "";
    in-out property <string> error-text: "";
    in-out property <bool> busy: false;
    in-out property <bool> show-2fa: false;
    in-out property <string> twofa: "";
    in-out property <int> server-index: 0;
    in-out property <string> server-label: "PL-1";
    in-out property <string> server-host-label: "";
    in-out property <string> background-effect: "none";
    in-out property <string> set-background-effect: "none";
    in-out property <bool> server-menu-open: false;
    in-out property <bool> is-kydasay: false;
    in-out property <bool> startup-ready: false;
    in-out property <string> countdown-text: "";
    in-out property <string> main-status: "";

    // ---- main ------------------------------------------------------------
    in-out property <string> user-name: "";
    in-out property <string> user-initial: "?";
    in-out property <image> user-avatar;
    in-out property <bool> has-avatar: false;
    in-out property <[ProfileItem]> profiles: [];
    in-out property <int> selected-index: -1;
    in-out property <string> selected-title: "Профиль не выбран";
    in-out property <string> selected-description: "";
    in-out property <string> selected-version: "";
    in-out property <string> selected-online: "";
    in-out property <image> selected-icon;
    in-out property <[NewsItem]> news: [];
    in-out property <[ModItem]> mods: [];
    in-out property <int> mods-enabled: 0;
    in-out property <int> mods-total: 0;
    in-out property <bool> can-play: false;

    in-out property <bool> progress-visible: false;
    in-out property <float> progress-value: 0;
    in-out property <string> progress-title: "";
    in-out property <string> progress-text: "";
    in-out property <string> progress-speed: "";

    in-out property <string> backend-mode: "";
    in-out property <bool> backend-mode-visible: false;
    in-out property <bool> backend-mode-expanded: true;
    in-out property <color> backend-mode-color: #2e9e5b;

    // ---- settings --------------------------------------------------------
    in-out property <string> set-install-dir: "";
    in-out property <int> set-xms: 2048;
    in-out property <int> set-xmx: 8192;
    in-out property <string> set-width-text: "900";
    in-out property <string> set-height-text: "600";
    in-out property <bool> set-fullscreen: false;
    in-out property <string> set-custom-jvm: "";

    in-out property <bool> set-send-hwid: true;
    in-out property <bool> set-sounds: true;
    in-out property <bool> set-hide-on-launch: true;
    in-out property <int> max-ram: 16384;
    in-out property <string> settings-status: "";

    in-out property <string> mirror-key: "";
    in-out property <string> mirror-mode: "";
    in-out property <string> mirror-upstream: "";
    in-out property <bool> mirror-can-control: false;
    in-out property <bool> mirror-tor: false;
    in-out property <bool> mirror-tor-available: false;
    in-out property <[SelfTestItem]> selftest: [];
    in-out property <string> selftest-summary: "";

    callback login-clicked();
    callback verify-clicked();
    callback offline-clicked();
    callback hwid-toggled(bool);
    callback logout-clicked();
    callback settings-clicked();
    callback back-clicked();
    callback play-clicked();
    callback refresh-clicked();
    callback mods-clicked();
    callback mods-refresh-clicked();
    callback mod-toggled(int, bool);
    callback server-clicked(int);
    callback profile-clicked(int);
    callback save-settings-clicked();
    callback check-backend-clicked();
    callback adjust-xms(int);
    callback adjust-xmx(int);
    callback mirror-save-key();
    callback mirror-clear-key();
    callback mirror-mode-clicked(string);
    callback mirror-tor-toggled(bool);
    callback selftest-clicked();
    callback maximize-clicked();

    // =====================================================================
    // LOGIN
    // =====================================================================
    if screen == 0: Rectangle {
        width: 100%;
        y: 34px;
        height: root.height - 34px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: #0e0e11;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.4;
        }

        Rectangle {
            background: @linear-gradient(180deg, #0e0e11cc 0%, #0e0e11f0 55%, #0e0e11 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                width: 440px;
                spacing: 18px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Image {
                        source: @image-url("../assets/logo.svg");
                        width: 44px;
                        height: 44px;
                    }
                    Text {
                        text: "Vestalis";
                        color: #ffffff;
                        font-size: 40px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Femboy Edition";
                        color: #d8b4fe;
                        font-size: 14px;
                        vertical-alignment: bottom;
                    }
                }

                Rectangle {
                    height: root.show-2fa ? 590px : 485px;
                    border-radius: 16px;
                    background: #121216f2;
                    border-width: 1px;
                    border-color: #292930;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 12px;

                        Text {
                            text: "Вход в аккаунт";
                            color: #ffffff;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Войдите, чтобы играть на серверах Vestalis";
                            color: #85858f;
                            font-size: 14px;
                        }

                        Rectangle { height: 4px; }

                        TextField {
                            text <=> root.login;
                            placeholder: "Логин";
                            accepted => { root.login-clicked(); }
                        }
                        TextField {
                            text <=> root.password;
                            placeholder: "Пароль";
                            password: true;
                            accepted => { root.login-clicked(); }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Toggle {
                                checked: root.set-send-hwid;
                                toggled(v) => { root.set-send-hwid = v; root.hwid-toggled(v); }
                            }
                            Text {
                                text: "Отправлять HWID";
                                color: #9a9aa6;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.show-2fa: VerticalLayout {
                            spacing: 8px;
                            TextField {
                                text <=> root.twofa;
                                placeholder: "Код двухфакторной аутентификации";
                                accepted => { root.verify-clicked(); }
                            }
                            ActionButton {
                                label: root.busy ? "Проверка…" : "Подтвердить код";
                                primary: true;
                                available: !root.busy;
                                clicked => { root.verify-clicked(); }
                            }
                        }

                        Text {
                            text: root.error-text;
                            color: #f87171;
                            font-size: 14px;
                            wrap: word-wrap;
                            visible: !root.error-text.is-empty;
                        }

                        Rectangle { vertical-stretch: 1; }

                        ActionButton {
                            label: root.busy ? "Подключение…" : "Войти";
                            primary: true;
                            available: !root.busy;
                            clicked => { root.login-clicked(); }
                        }
                        ActionButton {
                            label: "Оффлайн-режим";
                            available: !root.busy;
                            clicked => { root.offline-clicked(); }
                        }
                    }
                }

                Text {
                    text: "v" + root.app-version;
                    color: #55555f;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MAIN
    // =====================================================================
    if screen == 1: Rectangle {
        width: 100%;
        y: 34px;
        height: root.height - 34px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: #0d0d10;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.22;
        }
        Rectangle {
            background: @linear-gradient(120deg, #0d0d10f5 0%, #0d0d10d9 55%, #0d0d10f2 100%);
        }

        if root.background-effect != "none": BackgroundEffect {
            kind: root.background-effect;
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            spacing: 0px;

            // ---- sidebar ----
            Rectangle {
                width: 316px;
                background: #0a0a0df2;
                border-width: 0px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            source: @image-url("../assets/logo.svg");
                            width: 34px;
                            height: 34px;
                        }
                        Text {
                            text: "Vestalis";
                            color: #ffffff;
                            font-size: 24px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Femboy";
                            color: #c084fc;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 64px;
                        border-radius: 12px;
                        background: #131318;
                        border-width: 1px;
                        border-color: #24242c;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            Rectangle {
                                width: 42px;
                                height: 42px;
                                border-radius: 10px;
                                clip: true;
                                background: @linear-gradient(135deg, #a21caf 0%, #6d28d9 100%);
                                Image {
                                    source: root.user-avatar;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                    visible: root.has-avatar;
                                }
                                Text {
                                    text: root.user-initial;
                                    color: #ffffff;
                                    font-size: 18px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: !root.has-avatar;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: root.user-name;
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.server-host-label;
                                    color: #777783;
                                    font-size: 14px;
                                }
                            }
                        }
                    }

                    Text {
                        text: "ПРОФИЛИ";
                        color: #6d6d79;
                        font-size: 14px;
                        font-weight: 700;
                        letter-spacing: 1.4px;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for p in root.profiles: Rectangle {
                                height: 62px;
                                border-radius: 11px;
                                background: p.id == root.selected-index ? #2a1030e6
                                    : row-area.has-hover ? #191920 : #00000000;
                                border-width: 1px;
                                border-color: p.id == root.selected-index ? #a21caf : #00000000;
                                animate background { duration: 140ms; easing: ease-out; }
                                animate border-color { duration: 140ms; }

                                row-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.profile-clicked(p.id); }
                                }

                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 9px;
                                        background: #1c1c24;
                                        clip: true;
                                        Text {
                                            text: p.initial;
                                            color: #8b8b99;
                                            font-size: 18px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            visible: !p.has-icon;
                                        }
                                        Image {
                                            source: p.icon;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: p.display-name;
                                            color: p.id == root.selected-index ? #ffffff : #d2d2dc;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: p.subtitle;
                                            color: #74747f;
                                            font-size: 14px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 124px;
                        border-radius: 14px;
                        background: #121218e6;
                        border-width: 1px;
                        border-color: #2a2a34;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;

                            Rectangle {
                                width: 102px;
                                height: 104px;
                                border-radius: 12px;
                                clip: true;
                                background: #0b0b0f;

                                Image {
                                    source: @image-url("../assets/nedrochabr.png");
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "НЕДРОЧАБРЬ";
                                    color: #f0abfc;
                                    font-size: 13px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                Text {
                                    text: root.countdown-text;
                                    color: #b9b9c4;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: "Настройки";
                            clicked => { root.settings-clicked(); }
                        }
                        ActionButton {
                            label: "Выйти";
                            clicked => { root.logout-clicked(); }
                        }
                    }
                }
            }

            // ---- content ----
            VerticalLayout {
                width: root.width - 316px;
                padding: 28px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 26px;
                        width: version-text.preferred-width + 24px;
                        border-radius: 8px;
                        background: #1a1a21;
                        border-width: 1px;
                        border-color: #2c2c35;
                        visible: !root.selected-version.is-empty;
                        version-text := Text {
                            text: root.selected-version;
                            color: #b7b7c3;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        width: online-text.preferred-width + 24px;
                        border-radius: 8px;
                        background: #122016;
                        border-width: 1px;
                        border-color: #1f4a2c;
                        visible: !root.selected-online.is-empty;
                        online-text := Text {
                            text: root.selected-online;
                            color: #6ee7a0;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: root.backend-mode-expanded ? 26px : 16px;
                        width: root.backend-mode-expanded ? mode-text.preferred-width + 28px : 16px;
                        border-radius: root.backend-mode-expanded ? 9px : 8px;
                        background: root.backend-mode-color;
                        visible: root.backend-mode-visible;
                        animate width { duration: 220ms; easing: ease-out; }
                        animate height { duration: 220ms; easing: ease-out; }
                        animate border-radius { duration: 220ms; }
                        animate background { duration: 220ms; }

                        mode-text := Text {
                            text: root.backend-mode;
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: root.backend-mode-expanded;
                            opacity: root.backend-mode-expanded ? 1 : 0;
                            animate opacity { duration: 160ms; }
                        }
                    }
                }

                Text {
                    text: root.selected-title;
                    color: #ffffff;
                    font-size: 40px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.selected-description;
                    color: #9a9aa4;
                    font-size: 14px;
                    wrap: word-wrap;
                    max-height: 58px;
                    overflow: elide;
                }

                Rectangle { height: 8px; }

                Text {
                    text: "НОВОСТИ";
                    color: #6d6d79;
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for n in root.news: Rectangle {
                            height: news-layout.preferred-height + 28px;
                            border-radius: 12px;
                            background: #111116e6;
                            border-width: 1px;
                            border-color: #22222a;

                            news-layout := VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text {
                                    text: n.title;
                                    color: #ededf2;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: n.body;
                                    color: #8c8c98;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: n.date;
                                    color: #5d5d68;
                                    font-size: 14px;
                                    visible: !n.date.is-empty;
                                }
                            }
                        }
                    }
                }

                if root.progress-visible: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.progress-title;
                            color: #e4e4ee;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.progress-speed;
                            color: #a78bfa;
                            font-size: 14px;
                        }
                    }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #22222a;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.progress-value;
                            height: 100%;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, #a21caf 0%, #c084fc 100%);
                            animate width { duration: 160ms; easing: ease-out; }
                        }
                    }
                    Text {
                        text: root.progress-text;
                        color: #7c7c88;
                        font-size: 14px;
                        overflow: elide;
                    }
                }

                if !root.main-status.is-empty: Text {
                    text: root.main-status;
                    color: #6ee7a0;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                if !root.error-text.is-empty: Text {
                    text: root.error-text;
                    color: #f87171;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle { height: 2px; }

                HorizontalLayout {
                    spacing: 14px;
                    ActionButton {
                        label: "Играть";
                        primary: true;
                        available: root.can-play;
                        width: 220px;
                        height: 52px;
                        clicked => { root.play-clicked(); }
                    }
                    ActionButton {
                        label: "Обновить";
                        width: 130px;
                        height: 52px;
                        clicked => { root.refresh-clicked(); }
                    }
                    ActionButton {
                        label: "Моды";
                        width: 110px;
                        height: 52px;
                        clicked => { root.mods-clicked(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    // =====================================================================
    // SETTINGS
    // =====================================================================
    Rectangle {
        visible: screen == 2;
        width: 100%;
        y: 34px;
        height: root.height - 34px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: #0d0d10;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: "← Назад";
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: "Настройки";
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.settings-status;
                    color: #6ee7a0;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    // ---- column 1 ----
                    VerticalLayout {
                        width: 50%;
                        spacing: 16px;

                        Rectangle {
                            border-radius: 14px;
                            background: #121217e6;
                            border-width: 1px;
                            border-color: #24242c;
                            height: ram-layout.preferred-height + 40px;

                            ram-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Память"; color: #ffffff; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Сколько оперативной памяти выделять игре. Всего в системе: " + root.max-ram + " МБ.";
                                    color: #8a8a96;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Минимум (Xms)"; color: #b9b9c4; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xms(-512); } }
                                    Text {
                                        text: root.set-xms + " МБ";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xms(512); } }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Максимум (Xmx)"; color: #b9b9c4; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    ActionButton { label: "−"; width: 40px; clicked => { root.adjust-xmx(-1024); } }
                                    Text {
                                        text: root.set-xmx + " МБ";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        width: 90px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { label: "+"; width: 40px; clicked => { root.adjust-xmx(1024); } }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: #121217e6;
                            border-width: 1px;
                            border-color: #24242c;
                            height: jvm-layout.preferred-height + 40px;

                            jvm-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Дополнительные аргументы JVM"; color: #ffffff; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Флаги добавляются перед classpath. Флаги -Xms/-Xmx здесь игнорируются.";
                                    color: #8a8a96;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                TextField {
                                    text <=> root.set-custom-jvm;
                                    placeholder: "-XX:+UseZGC -XX:+UnlockExperimentalVMOptions";
                                }
                            }
                        }
                    }

                    // ---- column 2 ----
                    VerticalLayout {
                        width: 50%;
                        spacing: 16px;

                        Rectangle {
                            border-radius: 14px;
                            background: #121217e6;
                            border-width: 1px;
                            border-color: #24242c;
                            height: window-layout.preferred-height + 40px;

                            window-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Окно игры"; color: #ffffff; font-size: 17px; font-weight: 700; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Полноэкранный режим"; color: #b9b9c4; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-fullscreen;
                                        toggled(v) => { root.set-fullscreen = v; }
                                    }
                                }

                                if !root.set-fullscreen: HorizontalLayout {
                                    spacing: 10px;
                                    TextField { text <=> root.set-width-text; numeric: true; horizontal-stretch: 1; }
                                    Text { text: "×"; color: #6d6d79; vertical-alignment: center; }
                                    TextField { text <=> root.set-height-text; numeric: true; horizontal-stretch: 1; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: "Скрывать лаунчер при запуске игры";
                                        color: #b9b9c4;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Toggle {
                                        checked: root.set-hide-on-launch;
                                        toggled(v) => { root.set-hide-on-launch = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px;
                            background: #121217e6;
                            border-width: 1px;
                            border-color: #24242c;
                            height: launcher-layout.preferred-height + 40px;

                            launcher-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Лаунчер"; color: #ffffff; font-size: 17px; font-weight: 700; }

                                Text { text: "Папка установки"; color: #b9b9c4; font-size: 14px; }
                                TextField {
                                    text <=> root.set-install-dir;
                                    placeholder: "%APPDATA%\\Vestalis";
                                }

                                Text { text: "Фон лаунчера"; color: #b9b9c4; font-size: 14px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Нет";
                                        primary: root.set-background-effect == "none";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "none"; root.background-effect = "none"; }
                                    }
                                    ActionButton {
                                        label: "Светлячки";
                                        primary: root.set-background-effect == "fireflies";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "fireflies"; root.background-effect = "fireflies"; }
                                    }
                                    ActionButton {
                                        label: "Листья";
                                        primary: root.set-background-effect == "leaves";
                                        width: 112px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "leaves"; root.background-effect = "leaves"; }
                                    }
                                    ActionButton {
                                        label: "Снежинки";
                                        primary: root.set-background-effect == "snow";
                                        width: 128px;
                                        height: 38px;
                                        clicked => { root.set-background-effect = "snow"; root.background-effect = "snow"; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Отправлять реальный HWID"; color: #b9b9c4; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-send-hwid;
                                        toggled(v) => { root.set-send-hwid = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Звуки интерфейса"; color: #b9b9c4; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Toggle {
                                        checked: root.set-sounds;
                                        toggled(v) => { root.set-sounds = v; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            visible: root.server-index == 3 && root.is-kydasay;
                            border-radius: 14px;
                            background: #121217e6;
                            border-width: 1px;
                            border-color: #24242c;
                            height: mirror-layout.preferred-height + 40px;

                            mirror-layout := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text { text: "Сервисный доступ · PL-1"; color: #ffffff; font-size: 17px; font-weight: 700; }
                                Text {
                                    text: "Ключ хранится локально и не входит в сборку. С ним доступны переключение режима, Tor и самодиагностика.";
                                    color: #8a8a96;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                TextField {
                                    text <=> root.mirror-key;
                                    placeholder: "X-Mirror-Control-Key";
                                    password: true;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Сохранить ключ";
                                        width: 150px;
                                        clicked => { root.mirror-save-key(); }
                                    }
                                    ActionButton {
                                        label: "Удалить";
                                        width: 100px;
                                        clicked => { root.mirror-clear-key(); }
                                    }
                                }

                                Text {
                                    text: "Режим: " + (root.mirror-mode.is-empty ? "неизвестен" : root.mirror-mode)
                                        + (root.mirror-upstream.is-empty ? "" : " · upstream: " + root.mirror-upstream);
                                    color: #b9b9c4;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                if root.mirror-can-control: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton {
                                            label: "Зеркало";
                                            width: 110px;
                                            primary: root.mirror-mode == "local";
                                            clicked => { root.mirror-mode-clicked("local"); }
                                        }
                                        ActionButton {
                                            label: "Прокси";
                                            width: 110px;
                                            primary: root.mirror-mode == "proxy";
                                            clicked => { root.mirror-mode-clicked("proxy"); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: "Запросы к основному бэкенду через Tor";
                                            color: #b9b9c4;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            visible: root.mirror-tor-available;
                                        }
                                        Toggle {
                                            checked: root.mirror-tor;
                                            visible: root.mirror-tor-available;
                                            toggled(v) => { root.mirror-tor-toggled(v); }
                                        }
                                    }
                                    ActionButton {
                                        label: "Самодиагностика";
                                        width: 170px;
                                        clicked => { root.selftest-clicked(); }
                                    }
                                }

                                if !root.selftest-summary.is-empty: Text {
                                    text: root.selftest-summary;
                                    color: #a78bfa;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }

                                for row in root.selftest: Rectangle {
                                    height: row-layout.preferred-height + 16px;
                                    border-radius: 8px;
                                    background: #0f0f14;
                                    border-width: 1px;
                                    border-color: row.status == "ok" ? #1f4a2c
                                        : row.status == "warn" ? #5a3d12 : #5a1f1f;
                                    row-layout := HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: row.status == "ok" ? "ОК" : row.status == "warn" ? "ВНИМАНИЕ" : "ОШИБКА";
                                            color: row.status == "ok" ? #6ee7a0 : row.status == "warn" ? #fbbf24 : #f87171;
                                            font-size: 14px;
                                            font-weight: 700;
                                            width: 70px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.name;
                                            color: #e4e4ee;
                                            font-size: 14px;
                                            font-weight: 600;
                                            width: 140px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.message;
                                            color: #85858f;
                                            font-size: 14px;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: row.duration;
                                            color: #66666f;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: "Сохранить настройки";
                    primary: true;
                    width: 240px;
                    height: 48px;
                    clicked => { root.save-settings-clicked(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "v" + root.app-version;
                    color: #55555f;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // MODS
    // =====================================================================
    if screen == 3: Rectangle {
        width: 100%;
        y: 34px;
        height: root.height - 34px;
        opacity: root.screen-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
        background: #0d0d10;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    label: "← Назад";
                    width: 120px;
                    clicked => { root.back-clicked(); }
                }
                Text {
                    text: "Моды";
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.mods-enabled + " из " + root.mods-total + " включено";
                    color: #8a8a96;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    label: "Обновить";
                    width: 130px;
                    clicked => { root.mods-refresh-clicked(); }
                }
            }

            Text {
                text: "Опциональные моды. Выключенные файлы хранятся с суффиксом .disabled.";
                color: #6f6f7a;
                font-size: 14px;
                wrap: word-wrap;
            }

            if root.mods-total == 0: Text {
                text: "Для этого профиля нет опциональных модов.";
                color: #8a8a96;
                font-size: 14px;
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for m in root.mods: Rectangle {
                        height: mod-row.preferred-height + 18px;
                        border-radius: 12px;
                        background: #121217e6;
                        border-width: 1px;
                        border-color: m.enabled ? #3a1d40 : #23232b;

                        mod-row := HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: m.name;
                                    color: #ededf2;
                                    font-size: 14px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: m.description;
                                    color: #85858f;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    visible: !m.description.is-empty;
                                }
                            }

                            Toggle {
                                checked: m.enabled;
                                toggled(v) => { root.mod-toggled(m.id, v); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Branded start screen. The real window is already behind it, so the
    // hand-over is instant once the first backend requests are in flight.
    if root.splash: Rectangle {
        width: 100%;
        height: 100%;
        background: #0b0b0e;

        Image {
            source: @image-url("../assets/background.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.18;
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;

            Rectangle { height: 90px; }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                Image {
                    source: @image-url("../assets/logo.svg");
                    width: 64px;
                    height: 64px;
                }
                Text {
                    text: "Vestalis";
                    color: #ffffff;
                    font-size: 56px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Femboy Edition";
                color: #d8b4fe;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Rectangle { height: 18px; }
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 260px;
                    height: 4px;
                    border-radius: 2px;
                    background: #22222a;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.splash-progress;
                        height: 100%;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, #6d28d9 0%, #e879f9 50%, #6d28d9 100%);
                    }
                }
            }
            Text {
                text: "Загрузка…";
                color: #777783;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    // Custom title bar (the window uses no-frame).
    Rectangle {
        y: 0;
        width: 100%;
        height: 34px;
        background: #0a0a0df5;
        border-width: 0px;

        WindowMoveArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 6px;

            Text {
                text: "Vestalis Launcher";
                color: #66666f;
                font-size: 14px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 124px;
                height: 26px;
                border-radius: 7px;
                background: root.server-menu-open ? #24242e : #17171d;
                border-width: 1px;
                border-color: root.server-menu-open ? #a21caf : #2c2c36;
                animate background { duration: 120ms; }

                Text {
                    x: 10px;
                    text: root.server-label;
                    color: #e4e4ee;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    x: parent.width - 18px;
                    text: "v";
                    color: #8a8a96;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.server-menu-open = !root.server-menu-open; }
                }
            }

            CaptionButton {
                label: "-";
                clicked => { root.minimized = true; }
            }
            CaptionButton {
                label: root.window-maximized ? "❐" : "□";
                clicked => { root.maximize-clicked(); }
            }
            CaptionButton {
                label: "✕";
                close: true;
                clicked => { root.close(); }
            }
        }
    }

    if root.server-menu-open: Rectangle {
        y: 34px;
        width: 100%;
        height: root.height - 34px;
        background: #00000000;

        TouchArea {
            clicked => { root.server-menu-open = false; }
        }
    }

    if root.server-menu-open: Rectangle {
        x: root.width - 262px;
        y: 38px;
        width: 160px;
        height: 150px;
        border-radius: 10px;
        background: #14141af5;
        border-width: 1px;
        border-color: #2c2c36;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            ServerMenuItem {
                label: "RU-1";
                active: root.server-index == 0;
                clicked => { root.server-menu-open = false; root.server-clicked(0); }
            }
            ServerMenuItem {
                label: "RU-2";
                active: root.server-index == 1;
                clicked => { root.server-menu-open = false; root.server-clicked(1); }
            }
            ServerMenuItem {
                label: "EU-1";
                active: root.server-index == 2;
                clicked => { root.server-menu-open = false; root.server-clicked(2); }
            }
            ServerMenuItem {
                label: "PL-1";
                active: root.server-index == 3;
                clicked => { root.server-menu-open = false; root.server-clicked(3); }
            }
        }
    }
}
